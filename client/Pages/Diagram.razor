    private Task ShowAllRelationsAsync() => CurrentDomain is { } d ? SaveDomainSettingsAsync(d, hiddenRelations: []) : Task.CompletedTask;

    private Task HideAllRelationsAsync() => CurrentDomain is { } d
        ? SaveDomainSettingsAsync(d, hiddenRelations: DomainRelations.Select(r => r.Id).ToHashSet())
        : Task.CompletedTask;

    private async Task SaveDomainSettingsAsync(DomainView domain, bool? showNeighbors = null, IEnumerable<string>? hiddenRelations = null)
    {
        await ApiErrors.TryAsync(async () =>
        {
            await Api.SaveDomainSettingsAsync(domain.Id, showNeighbors, hiddenRelations);
            if (showNeighbors != null) domain.ShowNeighbors = showNeighbors.Value;
            if (hiddenRelations != null) domain.HiddenRelations = hiddenRelations.ToList();
            ClearSelection();
            Rebuild();
        }, ShowError);
    }

    private void ToggleAllColumns(bool on)
    {
        _allColumns = on;
        Rebuild();
    }

    /// <summary>Tables hors du domaine reliées par une relation à l'une de ses tables.</summary>
    private HashSet<string> FrontierOf(HashSet<string> members, ISet<string> hidden)
    {
        var tableOfColumn = _tables.SelectMany(t => t.Columns.Select(c => (Column: c.Id, Table: t.Id))).ToDictionary(x => x.Column, x => x.Table);
        var frontier = new HashSet<string>();
        foreach (var relation in _tables.SelectMany(t => t.Relations).Where(r => !hidden.Contains(r.Id)))
        {
            if (!tableOfColumn.TryGetValue(relation.FirstId, out var first) || !tableOfColumn.TryGetValue(relation.SecondId, out var second))
                continue;
            if (members.Contains(first) && !members.Contains(second)) frontier.Add(second);
            if (members.Contains(second) && !members.Contains(first)) frontier.Add(first);
        }

        return frontier;
    }

    // --- Domaines ---

    private async Task SelectDomainAsync(string? domainId)
    {
        _domainId = domainId;
        ClearSelection();
        Rebuild(keepPositions: false);
        await LoadDomainCompletenessAsync();
    }

    private async Task LoadDomainCompletenessAsync()
    {
        _domainCompleteness = _domainId == null ? null : await Api.GetCompletenessAsync(Id, _domainId);
    }

    private async Task ReloadDomainsAsync()
    {
        _domains = await Api.GetDomainsAsync(Id);
        if (_domainId != null && _domains.All(d => d.Id != _domainId)) _domainId = null;
        await LoadDomainCompletenessAsync();
    }

    private async Task CreateDomainAsync()
    {
        var name = _newDomain.Trim();
        if (name.Length == 0) return;
        await ApiErrors.TryAsync(async () =>
        {
            var created = await Api.CreateDomainAsync(Id, name);
            _newDomain = "";
            await ReloadDomainsAsync();
            Workspace.NotifyCatalogChanged(Id, this);
            await SelectDomainAsync(created.Id);
        }, ShowError);
    }

    /// <summary>Fenêtre « Nouveau domaine » : nom, couleur et tables ; les tables affichées en ce moment sont proposées d'office.</summary>
    private async Task OpenDomainDialogAsync()
    {
        var parameters = new DialogParameters<DomainDialog>
        {
            { x => x.DatabaseId, Id }, { x => x.Tables, _tables }, { x => x.Domains, _domains },
            { x => x.InitialTables, CurrentDomain == null ? _visible.ToList() : null }
        };
        var created = await Dialogs.ShowDataAsync<DomainDialog, string>("Nouveau domaine", parameters, MaxWidth.Large);
        if (created == null) return;
        await ReloadDomainsAsync();
        Workspace.NotifyCatalogChanged(Id, this);
        await SelectDomainAsync(created);
        Notifier.Show("Domaine créé.");
    }

    private async Task OnNewDomainKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateDomainAsync();
    }

    private void StartRename(DomainView domain)
    {
        _renaming = domain.Id;
        _renameText = domain.Name;
    }

    private async Task OnRenameKey(KeyboardEventArgs e, DomainView domain)
    {
        if (e.Key == "Escape")
        {
            _renaming = null;
        }
        else if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_renameText))
        {
            await ApiErrors.TryAsync(async () =>
            {
                await Api.RenameDomainAsync(domain, _renameText.Trim());
                _renaming = null;
                await ReloadDomainsAsync();
                Workspace.NotifyCatalogChanged(Id, this);
            }, ShowError);
        }
    }

    private async Task DeleteDomainAsync(DomainView domain)
    {
        await ApiErrors.TryAsync(async () =>
        {
            await Api.DeleteDomainAsync(domain.Id);
            if (_domainId == domain.Id) _domainId = null;
            await ReloadDomainsAsync();
            Rebuild(keepPositions: false);
            Workspace.NotifyCatalogChanged(Id, this);
            // Annuler recrée le domaine, avec les mêmes tables à la même place (l'identifiant change).
            Notifier.Show($"Domaine {domain.Name} supprimé (ses tables sont conservées).", Severity.Success, async () =>
            {
                var again = await Api.CreateDomainAsync(Id, domain.Name, domain.Color);
                foreach (var place in domain.Tables)
                    await Api.AddTableToDomainAsync(again.Id, place.TableId, null, place.X, place.Y);
                await ReloadDomainsAsync();
                Rebuild(keepPositions: false);
                Workspace.NotifyCatalogChanged(Id, this);
                await InvokeAsync(StateHasChanged);
            });
        }, ShowError);
    }

    private static string? DomainStyle(DomainView domain)
    {
        return string.IsNullOrEmpty(domain.Color) ? null : $"border-left: 4px solid {domain.Color};";
    }

    // --- Glisser-déposer d'une table vers un domaine ---

    private void StartDrag(string tableId)
    {
        _draggedTable = tableId;
    }

    private void ClearDragged()
    {
        _draggedTable = null;
    }

    /// <summary>La table accrochée dans le diagramme sort du dessin : elle peut maintenant être déposée sur un domaine.</summary>
    private void DragLeave(ErNode node)
    {
        _draggedTable = node.Id;
    }

    /// <summary>
    ///     Dépose la table accrochée sur un domaine : elle y est rangée et, si on regardait un autre domaine dont elle
    ///     faisait partie, elle en est retirée (un déplacement).
    /// </summary>
    private async Task DropAsync(DomainView target)
    {
        var tableId = _draggedTable;
        _draggedTable = null;
        if (tableId == null) return;
        var current = CurrentDomain;
        var moveFrom = current != null && current.Id != target.Id && current.Tables.Any(t => t.TableId == tableId) ? current.Id : null;
        var name = _tables.FirstOrDefault(t => t.Id == tableId)?.Name ?? tableId;
        await ApiErrors.TryAsync(async () =>
        {
            await Api.AddTableToDomainAsync(target.Id, tableId, moveFrom);
            await ReloadDomainsAsync();
            Rebuild();
            Workspace.NotifyCatalogChanged(Id, this);
            Notifier.Show(moveFrom == null
                ? $"{name} ajoutée au domaine {target.Name}."
                : $"{name} déplacée vers le domaine {target.Name}.", Severity.Success, async () =>
            {
                // Annuler : la table quitte le domaine cible et retrouve l'ancien (à sa place mémorisée) s'il y en avait un.
                await Api.RemoveTableFromDomainAsync(target.Id, tableId);
                if (moveFrom != null) await Api.AddTableToDomainAsync(moveFrom, tableId);
                await ReloadDomainsAsync();
                Rebuild();
                Workspace.NotifyCatalogChanged(Id, this);
                await InvokeAsync(StateHasChanged);
            });
        }, ShowError);
    }

    /// <summary>Une table du domaine a été déplacée : sa place est mémorisée pour ce domaine.</summary>
    private async Task NodeMovedAsync(ErNode node)
    {
        var domain = CurrentDomain;
        if (domain == null || node.IsFrontier) return;
        await ApiErrors.TryAsync(async () =>
        {
            await Api.SaveLayoutAsync(domain.Id, [(node.Id, node.X, node.Y)]);
            var index = domain.Tables.FindIndex(t => t.TableId == node.Id);
            if (index >= 0) domain.Tables[index] = new DomainTableView { TableId = node.Id, X = node.X, Y = node.Y };
        }, ShowError);
    }

    // --- Tables affichées ---

    private async Task ToggleAsync(string tableId, bool on)
    {
        var domain = CurrentDomain;
        if (domain == null)
        {
            if (on) _visible.Add(tableId);
            else _visible.Remove(tableId);
            if (!on && _selectedTable == tableId) ClearSelection();
            Rebuild();
            return;
        }

        await ApiErrors.TryAsync(async () =>
        {
            if (on) await Api.AddTableToDomainAsync(domain.Id, tableId);
            else await Api.RemoveTableFromDomainAsync(domain.Id, tableId);
            await ReloadDomainsAsync();
            Workspace.NotifyCatalogChanged(Id, this);
            if (!on && _selectedTable == tableId) ClearSelection();
            Rebuild();
        }, ShowError);
    }

    private void SelectAll()
    {
        foreach (var table in _tables) _visible.Add(table.Id);
        Rebuild();
    }

    private void SelectNone()
    {
        _visible.Clear();
        ClearSelection();
        Rebuild();
    }

    /// <summary>Ne garde que l'élément sélectionné et les tables qui lui sont liées.</summary>
    private void ShowNeighbors()
    {
        if (_impact == null) return;
        _visible.Clear();
        _visible.Add(_impact.Root.TableId);
        foreach (var node in _impact.Dependents.Concat(_impact.Dependencies)) _visible.Add(node.TableId);
        Rebuild();
        _diagram.AutoLayout();
    }

    private void Relayout()
    {
        _diagram.AutoLayout();
    }

    private void Zoom(double delta)
    {
        _zoom = Math.Clamp(Math.Round(_zoom + delta, 2), 0.3, 2.5);
    }

    // --- Sélection et impact ---

    private void ClearSelection()
    {
        _selectedTable = _selectedColumn = null;
        _impact = null;
        _dependents = new HashSet<string>();
        _dependencies = new HashSet<string>();
    }

    private async Task SelectTableAsync(string tableId)
    {
        _selectedTable = tableId;
        _selectedColumn = null;
        await ShowImpactAsync("table", tableId);
    }

    private async Task SelectColumnAsync((string TableId, string ColumnId) selection)
    {
        _selectedTable = selection.TableId;
        _selectedColumn = selection.ColumnId;
        await ShowImpactAsync("column", selection.ColumnId);
    }

    private async Task ShowImpactAsync(string kind, string id)
    {
        var impact = await Api.GetImpactAsync(kind, id);
        // Une réponse tardive d'une sélection précédente ne doit pas écraser la dernière.
        if (kind == "table" ? _selectedTable != id || _selectedColumn != null : _selectedColumn != id) return;
        _impact = impact;
        // Un élément de colonne éclaire la colonne et sa table ; un élément de table, la table seule.
        _dependents = Ids(impact?.Dependents);
        _dependencies = Ids(impact?.Dependencies);
    }

    private static HashSet<string> Ids(IEnumerable<ImpactNode>? nodes)
    {
        var ids = new HashSet<string>();
        foreach (var node in nodes ?? [])
        {
            ids.Add(node.TableId);
            if (node.ColumnId != null) ids.Add(node.ColumnId);
        }

        return ids;
    }

    private void ShowError(string message) => _message.Warning(message);

    private void ShowInfo(string message) => _message.Success(message);

    // --- Exports ---

    private string FileBase => string.Concat((_database?.Name + (CurrentDomain == null ? "" : "_" + CurrentDomain.Name))
        .Select(c => char.IsLetterOrDigit(c) ? c : '_'));

    private Task ExportSvgAsync() => CallJsAsync("granitdb.download", $"{FileBase}.svg", "image/svg+xml", _diagram.ToSvg());

    private Task ExportMermaidAsync() => CallJsAsync("granitdb.download", $"{FileBase}.mmd", "text/plain", _diagram.ToMermaid());

    private Task CopyMermaidAsync() => CallJsAsync("granitdb.copyText", _diagram.ToMermaid());

    private Task ExportPngAsync()
    {
        var (width, height) = _diagram.Size();
        return CallJsAsync("granitdb.downloadPng", $"{FileBase}.png", _diagram.ToSvg(), width, height);
    }

    private async Task CallJsAsync(string function, params object[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(function, args);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException)
        {
            ShowError("L'export a échoué dans ce navigateur.");
        }
    }
