@page "/databases/{Id}/diagram"
@using GranitDb.Client.api
@using GranitDb.Client.Components
@using GranitDb.Client.Components.Dialogs
@using GranitDb.Client.Diagram
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject Client Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject WorkspaceState Workspace
@inject Notifier Notifier
@inject IDialogService Dialogs
@inject DiagramPanelState Panels
@implements IDisposable

<PageTitle>Diagramme — @(_database?.Name ?? "Base")</PageTitle>

@* Un dépôt relâché n'importe où ailleurs que sur un domaine annule le glisser en cours. *@
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-6" @onpointerup="ClearDragged">
    <PageCrumbs DatabaseId="@Id" DatabaseName="@_database?.Name" Current="Diagramme" />

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_database == null)
    {
        <MudAlert Severity="Severity.Warning">Base introuvable.</MudAlert>
    }
    else if (_tables.Length == 0)
    {
        <MudAlert Severity="Severity.Info">Cette base n'a aucune table à représenter.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-3">Diagramme de @_database.Name@(CurrentDomain == null ? "" : $" — {CurrentDomain.Name}")</MudText>

        <PageMessageAlert Message="_message" />

        <MudGrid>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-3 mb-3" id="domains">
                    @* Le panneau se réduit à son titre pour laisser toute la place à la liste des tables. *@
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIconButton Icon="@(_domainsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small"
                                       Class="domains-toggle" OnClick="() => _domainsOpen = !_domainsOpen"
                                       aria-expanded="@(_domainsOpen ? "true" : "false")" aria-controls="domains-body"
                                       aria-label="@(_domainsOpen ? "Réduire le panneau des domaines" : "Déployer le panneau des domaines")"
                                       title="@(_domainsOpen ? "Réduire pour voir la liste des tables" : "Déployer les domaines")" />
                        <MudText Typo="Typo.subtitle1">Domaines (@_domains.Length)</MudText>
                        @if (!_domainsOpen)
                        {
                            <Muted Typo="Typo.caption" Class="domains-current">
                                @(CurrentDomain == null ? "Toutes les tables" : CurrentDomain.Name)
                            </Muted>
                        }
                    </MudStack>
                    @if (_domainsOpen)
                    {
                    <div id="domains-body">
                    <Muted Typo="Typo.caption">
                        Un domaine regroupe des tables pour un diagramme lisible. Glissez une table sur un domaine pour l'y ranger.
                    </Muted>
                    <MudTextField @bind-Value="_domainSearch" Label="Rechercher un domaine" Immediate="true" Clearable="true" Dense="true"
                                  Class="mb-1 domain-search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                    <div class="domain-list">
                    <div class="@($"domain-card domain-all{(_domainId == null ? " domain-selected" : "")}")" role="button" tabindex="0"
                         @onclick="() => SelectDomainAsync(null)">
                        <span>Toutes les tables</span>
                        <MudText Typo="Typo.caption">@_tables.Length</MudText>
                    </div>
                    @if (VisibleDomains.Count == 0 && !string.IsNullOrWhiteSpace(_domainSearch))
                    {
                        <MudText Typo="Typo.caption" Class="domain-search-empty">Aucun domaine ne contient « @_domainSearch.Trim() ».</MudText>
                    }
                    @foreach (var domain in VisibleDomains)
                    {
                        var current = domain;
                        <div class="@($"domain-card{(_domainId == domain.Id ? " domain-selected" : "")}{(_draggedTable != null ? " domain-target" : "")}")"
                             data-domain="@domain.Name" role="button" tabindex="0" style="@DomainStyle(domain)"
                             @onclick="() => SelectDomainAsync(current.Id)"
                             @onpointerup="() => DropAsync(current)" @onpointerup:stopPropagation="true"
                             @ondragover="() => { }" @ondragover:preventDefault="true"
                             @ondrop="() => DropAsync(current)">
                            <span class="domain-name">@domain.Name</span>
                            <MudText Typo="Typo.caption">@domain.Tables.Count</MudText>
                            <span class="domain-actions" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="domain-rename" aria-label="@($"Renommer {domain.Name}")"
                                           Title="Renommer" OnClick="() => StartRename(current)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="domain-delete" aria-label="@($"Supprimer {domain.Name}")"
                                           Title="Supprimer le domaine (les tables restent)" OnClick="() => DeleteDomainAsync(current)" />
                            </span>
                        </div>
                        @if (_renaming == domain.Id)
                        {
                            <MudTextField T="string" @bind-Value="_renameText" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true"
                                          AutoFocus="true" Class="domain-rename-input" OnKeyDown="e => OnRenameKey(e, current)" MaxLength="100" />
                        }
                    }
                    </div>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudTextField T="string" @bind-Value="_newDomain" Label="Nouveau domaine" Margin="Margin.Dense" Immediate="true"
                                      Class="new-domain-name" MaxLength="100" OnKeyDown="OnNewDomainKey" />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="new-domain-add" OnClick="CreateDomainAsync"
                                   Disabled="@string.IsNullOrWhiteSpace(_newDomain)">Créer</MudButton>
                    </MudStack>
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="OpenDomainDialogAsync" Class="mt-1 new-domain-dialog"
                               title="Choisir le nom, la couleur et les tables dans une fenêtre">Nouveau domaine avec ses tables…</MudButton>
                    @if (CurrentDomain != null && _domainCompleteness is { Tables: > 0 } documented)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 domain-completeness">Documentation du domaine : @documented.Percent %</MudText>
                    }
                    </div>
                    }
                </MudPaper>

                <MudPaper Class="pa-3">
                    <MudText Typo="Typo.subtitle1">
                        @if (CurrentDomain == null)
                        {
                            <text>Tables affichées (@_visible.Count / @_tables.Length)</text>
                        }
                        else
                        {
                            <text>Tables du domaine (@Members.Count / @_tables.Length)</text>
                        }
                    </MudText>
                    @if (CurrentDomain != null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="EditDomainAsync" Class="edit-domain" StartIcon="@Icons.Material.Filled.Tune"
                                   title="Ajouter des tables en lot (par préfixe ou par table liée) et voir combien de relations apparaissent">Modifier le domaine…</MudButton>
                        <Muted Typo="Typo.caption">
                            Cochez pour ajouter une table au domaine. Les tables en pointillés sont d'autres domaines, liées à celui-ci.
                        </Muted>
                    }
                    @if (Panels.SidebarHosts)
                    {
                        @* La liste à cocher est dans la barre latérale (explorateur) : on ne la répète pas ici. *@
                        <Muted Typo="Typo.caption" Class="picker-in-sidebar">
                            La liste des tables à afficher est dans la barre latérale, sous le filtre de l'explorateur.
                        </Muted>
                        @if (CurrentDomain == null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ShowNeighbors" Class="mt-1"
                                       Disabled="@(_impact == null)" title="Garde la sélection et les tables liées">Voisines</MudButton>
                        }
                    }
                    else
                    {
                    <MudTextField @bind-Value="_filter" Label="Filtrer" Immediate="true" Clearable="true" Dense="true" Class="mb-2" />
                    @if (CurrentDomain == null)
                    {
                        <MudStack Row="true" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SelectAll">Toutes</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SelectNone">Aucune</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ShowNeighbors"
                                       Disabled="@(_impact == null)" title="Garde la sélection et les tables liées">Voisines</MudButton>
                        </MudStack>
                    }
                    <div class="table-picker" style="@($"max-height: {(_domainsOpen ? "45vh" : "72vh")}; overflow-y: auto;")">
                        @foreach (var table in Filtered.Take(PickerLimit))
                        {
                            var current = table;
                            <div class="table-item" draggable="true" data-table-item="@table.Name"
                                 @ondragstart="() => StartDrag(current.Id)" @ondragend="ClearDragged">
                                <MudCheckBox T="bool" Value="@IsShown(table.Id)" ValueChanged="@(on => ToggleAsync(table.Id, on))"
                                             Label="@table.Name" Dense="true" Size="Size.Small" />
                            </div>
                        }
                        @if (Filtered.Skip(PickerLimit).Any())
                        {
                            <MudText Typo="Typo.caption">… @(Filtered.Count() - PickerLimit) autres : affinez le filtre.</MudText>
                        }
                    </div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="9">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" OnClick="() => Zoom(-0.1)" title="Zoom arrière" />
                    <MudText Typo="Typo.body2">@((int)Math.Round(_zoom * 100)) %</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" OnClick="() => Zoom(0.1)" title="Zoom avant" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Relayout"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh">Réorganiser</MudButton>
                    @if (CurrentDomain != null)
                    {
                        <MudCheckBox T="bool" Value="_allColumns" ValueChanged="ToggleAllColumns" Dense="true" Size="Size.Small"
                                     Label="Toutes les colonnes" />
                        <MudCheckBox T="bool" Value="CurrentDomain.ShowNeighbors" ValueChanged="SetShowNeighborsAsync" Dense="true"
                                     Size="Size.Small" Label="Tables voisines" Class="show-neighbors" />
                    }
                    <MudButton Size="Size.Small" Variant="@(_legendOpen ? Variant.Filled : Variant.Outlined)" OnClick="() => _legendOpen = !_legendOpen"
                               StartIcon="@Icons.Material.Filled.HelpOutline" Class="er-legend-toggle" aria-expanded="@(_legendOpen ? "true" : "false")">Légende</MudButton>
                    <MudSpacer />
                    @* Un seul menu pour tous les exports du diagramme. *@
                    <MudMenu Label="Exporter" StartIcon="@Icons.Material.Filled.Download" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                             Size="Size.Small" Variant="Variant.Outlined" Dense="true" Class="export-menu" aria-label="Exporter le diagramme">
                        <MudMenuItem OnClick="ExportSvgAsync" Class="export-svg">SVG</MudMenuItem>
                        <MudMenuItem OnClick="ExportPngAsync" Class="export-png">PNG</MudMenuItem>
                        <MudMenuItem OnClick="ExportMermaidAsync" Class="export-mermaid">Mermaid (fichier .mmd)</MudMenuItem>
                        <MudMenuItem OnClick="CopyMermaidAsync" Class="export-copy-mermaid">Copier Mermaid</MudMenuItem>
                    </MudMenu>
                </MudStack>

                @if (_diagram.Nodes.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@(CurrentDomain == null ? "Aucune table sélectionnée." : "Ce domaine est vide : cochez des tables ou glissez-les sur le domaine.")</MudAlert>
                }
                else
                {
                    @if (_legendOpen)
                    {
                        <div class="er-help" role="note" aria-label="Légende du diagramme">
                            <span class="er-legend-item"><b>1</b> = clé référencée (le côté « parent ») · <Term Key="cardinalite">cardinalité</Term></span>
                            <span class="er-legend-item"><b>N</b> = colonne qui référence (le côté « enfant »)</span>
                            <span class="er-legend-item"><b>PK</b> <Term Key="cle-primaire">clé primaire</Term> · <b>FK</b> <Term Key="cle-etrangere">clé étrangère</Term></span>
                            <span class="er-legend-item"><i class="er-swatch er-swatch-frontier"></i>Table en pointillés : d'un autre domaine, liée à celui-ci</span>
                            <span class="er-legend-item">Un trait qui part de plusieurs colonnes = une relation multi-colonnes (clé composite)</span>
                            <span class="er-legend-item">Glisser une table la déplace ; clic = voir ce qu'elle impacte ; Échap ou clic dans le vide = désélectionner · <a href="/help" class="help-link">En savoir plus</a></span>
                        </div>
                    }
                    @if (CurrentDomain != null && HiddenInDomain > 0)
                    {
                        <div class="er-hidden-banner" role="status">
                            @HiddenInDomain relation@(HiddenInDomain > 1 ? "s" : "") masquée@(HiddenInDomain > 1 ? "s" : "") dans ce domaine (le dessin est volontairement moins chargé).
                            <MudButton Size="Size.Small" OnClick="ShowAllRelationsAsync" Class="er-hidden-show">Tout afficher</MudButton>
                        </div>
                    }
                    <div class="er-focus" tabindex="-1" @onkeydown="OnDiagramKey">
                    <ErDiagramView Diagram="_diagram" Zoom="_zoom" SelectedTableId="@_selectedTable" SelectedColumnId="@_selectedColumn"
                                   Dependents="_dependents" Dependencies="_dependencies"
                                   OnSelectTable="SelectTableAsync" OnSelectColumn="SelectColumnAsync" OnClearSelection="ClearSelection"
                                   OnNodeMoved="NodeMovedAsync" OnDragLeave="DragLeave" />
                    </div>
                    <Muted Typo="Typo.caption">
                        Glissez une table pour la déplacer@(CurrentDomain == null ? "" : " (sa place est mémorisée pour ce domaine)") .
                        Cliquez une table ou une colonne pour voir ce qu'elle impacte, cliquez dans le vide pour désélectionner.
                        1 = clé référencée, N = colonne qui référence.
                    </Muted>
                    @if (_selectedTable != null)
                    {
                        <div class="er-legend" role="note" aria-label="Légende de la sélection">
                            <span class="er-legend-item"><i class="er-swatch er-swatch-selected"></i>Élément choisi</span>
                            <span class="er-legend-item"><i class="er-swatch er-swatch-dependent"></i>Le référence : peut casser si on modifie l'élément choisi</span>
                            <span class="er-legend-item"><i class="er-swatch er-swatch-dependency"></i>Référencé par l'élément choisi : il en dépend</span>
                            @if (_selectedColumn != null && _diagram.SiblingColumns(_selectedColumn).Count > 0)
                            {
                                <span class="er-legend-item"><i class="er-swatch er-swatch-sibling"></i>Autres colonnes de la même clé composite</span>
                            }
                            <MudButton Size="Size.Small" OnClick="ClearSelection" Class="er-legend-clear">Désélectionner</MudButton>
                        </div>
                    }
                }

                @if (CurrentDomain != null && DomainRelations.Count > 0)
                {
                    <MudExpansionPanels Class="mt-3" id="domain-relations">
                        <MudExpansionPanel Text="@($"Relations du domaine ({DomainRelations.Count - CurrentDomain.HiddenRelations.Count} affichée(s) sur {DomainRelations.Count})")">
                            <Muted Typo="Typo.caption" Class="domain-settings-help">
                                Une relation décochée n'est pas dessinée dans ce domaine (elle reste dans le catalogue). « Tables voisines » ajoute en pointillés les tables d'autres domaines reliées à celles-ci.
                            </Muted>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                                <MudTextField @bind-Value="_relationFilter" Label="Filtrer" Immediate="true" Clearable="true" Dense="true" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ShowAllRelationsAsync"
                                           Disabled="@(CurrentDomain.HiddenRelations.Count == 0)">Tout afficher</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="HideAllRelationsAsync">Tout masquer</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="HideIndirectAsync" Class="hide-indirect"
                                           Disabled="@(IndirectToHide == 0)"
                                           title="Ne garde que les clés étrangères détectées : masque les relations manuelles ou déduites des noms">Masquer les relations indirectes@(IndirectToHide > 0 ? $" ({IndirectToHide})" : "")</MudButton>
                                @if (CurrentDomain.HasDocumentationOrigin)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ResetToDocumentationAsync" Class="reset-dataedo"
                                               title="Remet les relations masquées comme dans la documentation d'origine (Dataedo)">Réinitialiser comme dans Dataedo</MudButton>
                                }
                            </MudStack>
                            <div style="max-height: 280px; overflow-y: auto;">
                                @foreach (var relation in DomainRelations.Where(r => string.IsNullOrWhiteSpace(_relationFilter) || r.Label.Contains(_relationFilter, StringComparison.OrdinalIgnoreCase)).Take(300))
                                {
                                    var current = relation;
                                    <div class="relation-item" data-relation="@relation.Label">
                                        <MudCheckBox T="bool" Value="@(!CurrentDomain.HiddenRelations.Contains(relation.Id))"
                                                     ValueChanged="@(on => ToggleRelationAsync(current.Id, on))" Dense="true" Size="Size.Small" Label="@relation.Label" />
                                    </div>
                                }
                            </div>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }

                @if (_impact != null)
                {
                    <MudPaper Class="pa-3 mt-3" id="impact">
                        <MudText Typo="Typo.h6">Impact de @_impact.Root.Label()</MudText>
                        <MudText Class="impact-sentence">@Phrases.Impact(_impact.Root.ColumnId != null, _impact.Dependents.Count, _impact.Dependencies.Count)</MudText>
                        <a class="impact-open" href="@_impact.Root.Href(Id)">Ouvrir la fiche de @_impact.Root.TableName</a>
                        @if (_impact.Dependents.Count == 0 && _impact.Dependencies.Count == 0)
                        {
                            <MudText>Aucune relation : rien ne dépend de cet élément dans le catalogue, et il ne dépend de rien.</MudText>
                        }
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <ImpactNodeList Title="Modifier cet élément peut casser" TitleColor="Color.Error" Nodes="_impact.Dependents" EmptyText="Rien ne le référence." DatabaseId="@Id" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <ImpactNodeList Title="Dépend de" TitleColor="Color.Info" Nodes="_impact.Dependencies" EmptyText="Ne référence rien." DatabaseId="@Id" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public string Id { get; set; } = "";

    /// <summary>Domaine à afficher à l'ouverture (lien depuis l'explorateur ou un favori).</summary>
    [SupplyParameterFromQuery(Name = "domain")] public string? DomainParam { get; set; }

    private DatabaseView? _database;
    private TableInfo[] _tables = [];
    private DomainView[] _domains = [];
    private string? _domainId;
    private readonly HashSet<string> _visible = [];
    private ErDiagram _diagram = ErDiagram.Build([]);
    private double _zoom = 1;
    private bool _domainsOpen = true;
    private string _domainSearch = "";
    private string? _filter;
    private bool _allColumns;
    private const int PickerLimit = 150;
    private const int LargeDatabase = 150;
    private bool _loading = true;
    private readonly PageMessage _message = new();

    private string? _draggedTable;
    private string _newDomain = "";
    private string? _renaming;
    private string _renameText = "";
    private CompletenessReport? _domainCompleteness;

    private bool _legendOpen;

    /// <summary>Relations entre les tables du domaine que son plan ne dessine pas.</summary>
    private int HiddenInDomain => CurrentDomain == null ? 0 : DomainRelations.Count(r => CurrentDomain.HiddenRelations.Contains(r.Id));

    private void OnDiagramKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _selectedTable != null) ClearSelection();
    }

    private string? _selectedTable;
    private string? _selectedColumn;
    private ImpactResult? _impact;
    private IReadOnlySet<string> _dependents = new HashSet<string>();
    private IReadOnlySet<string> _dependencies = new HashSet<string>();


    private DomainView? CurrentDomain => _domainId == null ? null : _domains.FirstOrDefault(d => d.Id == _domainId);

    private HashSet<string> Members => CurrentDomain?.Tables.Select(t => t.TableId).ToHashSet() ?? [];

    /// <summary>Les domaines dont le nom contient le texte cherché (tous quand la recherche est vide).</summary>
    private List<DomainView> VisibleDomains => string.IsNullOrWhiteSpace(_domainSearch)
        ? _domains.ToList()
        : _domains.Where(d => d.Name.Contains(_domainSearch.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    private IEnumerable<TableInfo> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? _tables
        : _tables.Where(t => t.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private bool IsShown(string tableId) => CurrentDomain == null ? _visible.Contains(tableId) : Members.Contains(tableId);

    protected override void OnInitialized() => Panels.Changed += OnPanelChanged;

    public void Dispose()
    {
        Panels.Changed -= OnPanelChanged;
        Panels.Clear();
    }

    private void OnPanelChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Publie la liste des tables dans la barre latérale (explorateur) : les coches y sont les mêmes que dans la page.</summary>
    private void PublishPanel()
    {
        if (_database == null || _tables.Length == 0)
        {
            Panels.Clear();
            return;
        }

        var domain = CurrentDomain;
        Panels.Publish(new DiagramPanel
        {
            DatabaseId = Id, DomainName = domain?.Name,
            Tables = _tables.Select(t => (t.Id, t.Name)).ToList(),
            Shown = domain == null ? new HashSet<string>(_visible) : Members,
            Toggle = ToggleAsync,
            SelectAll = domain == null ? () => { SelectAll(); return Task.CompletedTask; } : null,
            SelectNone = domain == null ? () => { SelectNone(); return Task.CompletedTask; } : null,
            DragStart = id => { StartDrag(id); _ = InvokeAsync(StateHasChanged); },
            DragEnd = () => { ClearDragged(); _ = InvokeAsync(StateHasChanged); }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _database = await Api.GetDatabaseAsync(Id);
        _tables = _database == null ? [] : (await Api.GetTablesAsync(Id)).OrderBy(t => t.Name).ToArray();
        _domains = _database == null ? [] : await Api.GetDomainsAsync(Id);
        _domainId = !string.IsNullOrEmpty(DomainParam) && _domains.Any(d => d.Id == DomainParam) ? DomainParam : null;
        // Une grosse base dessinée d'un bloc est illisible (et lente) : on ouvre le premier domaine, ou rien.
        var large = _tables.Length > LargeDatabase;
        if (_domainId == null && large && _domains.Length > 0)
            _domainId = _domains.OrderBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase).First().Id;
        _visible.Clear();
        if (!large)
            foreach (var table in _tables) _visible.Add(table.Id);
        ClearSelection();
        Rebuild(keepPositions: false);
        await LoadDomainCompletenessAsync();
        if (_database != null) Workspace.Describe(Navigation.Uri, $"Diagramme · {_database.Name}");
        _loading = false;
        PublishPanel();
    }

    /// <summary>
    ///     Reconstruit le diagramme. Sans domaine : les tables cochées. Avec un domaine : ses tables et, en pointillés,
    ///     les tables d'autres domaines qui leur sont reliées. Les tables déjà placées restent où l'utilisateur les a
    ///     mises ; sinon la place mémorisée du domaine est reprise.
    /// </summary>
    private void Rebuild(bool keepPositions = true)
    {
        var previous = keepPositions ? _diagram.Nodes.ToDictionary(n => n.Id, n => (n.X, n.Y)) : [];
        var domain = CurrentDomain;
        if (domain == null)
        {
            _diagram = ErDiagram.Build(_tables, _visible);
        }
        else
        {
            var members = Members;
            var hidden = domain.HiddenRelations.ToHashSet();
            var frontier = domain.ShowNeighbors ? FrontierOf(members, hidden) : [];
            _diagram = ErDiagram.Build(_tables, members.Union(frontier).ToHashSet(), frontier, relatedColumnsOnly: !_allColumns,
                hiddenRelations: hidden);
            var placed = 0;
            foreach (var place in domain.Tables.Where(t => t is { X: not null, Y: not null }))
                if (_diagram.Node(place.TableId) is { } node && !previous.ContainsKey(node.Id))
                {
                    (node.X, node.Y) = (place.X!.Value, place.Y!.Value);
                    placed++;
                }

            // Les tables voisines n'ont pas de place mémorisée : on les range sous le plan du domaine, sans le recouvrir.
            if (placed > 0 || previous.Count > 0) PlaceFrontierBelow(previous.Keys.ToHashSet());
        }

        foreach (var node in _diagram.Nodes)
            if (previous.TryGetValue(node.Id, out var position))
                (node.X, node.Y) = position;

        // Ouverture d'un domaine : le plan entier tient à l'écran (on peut ensuite zoomer).
        if (!keepPositions && domain != null)
            _zoom = Math.Clamp(Math.Round(1000 / Math.Max(1, _diagram.Size().Width), 1), 0.3, 1);
        if (!_loading) PublishPanel();
    }

    private void PlaceFrontierBelow(ISet<string> alreadyPlaced)
    {
        var own = _diagram.Nodes.Where(n => !n.IsFrontier).ToList();
        var outside = _diagram.Nodes.Where(n => n.IsFrontier && !alreadyPlaced.Contains(n.Id)).ToList();
        if (own.Count == 0 || outside.Count == 0) return;
        var x = ErDiagram.Margin;
        var y = own.Max(n => n.Y + n.Height) + 60;
        var width = Math.Max(1200, own.Max(n => n.X + n.Width));
        var rowHeight = 0.0;
        foreach (var node in outside)
        {
            if (x + node.Width > width && x > ErDiagram.Margin)
            {
                x = ErDiagram.Margin;
                y += rowHeight + 40;
                rowHeight = 0;
            }

            (node.X, node.Y) = (x, y);
            x += node.Width + 40;
            rowHeight = Math.Max(rowHeight, node.Height);
        }
    }

    private string? _relationFilter;

    /// <summary>Relations entre les tables affichées du domaine (masquées comprises), pour les cocher ou décocher.</summary>
    private List<(string Id, string Label, bool Indirect)> DomainRelations
    {
        get
        {
            var domain = CurrentDomain;
            if (domain == null) return [];
            var members = Members;
            var shown = domain.ShowNeighbors ? members.Union(FrontierOf(members, new HashSet<string>())).ToHashSet() : members;
            var tableOfColumn = new Dictionary<string, (string Table, string Label)>();
            foreach (var t in _tables.Where(t => shown.Contains(t.Id)))
                foreach (var c in t.Columns) tableOfColumn[c.Id] = (t.Id, $"{t.Name}.{c.Name}");
            return _tables.SelectMany(t => t.Relations).GroupBy(r => r.Id).Select(g => g.First())
                .Where(r => tableOfColumn.ContainsKey(r.FirstId) && tableOfColumn.ContainsKey(r.SecondId))
                .Select(r => (r.Id, Label: $"{tableOfColumn[r.SecondId].Label} → {tableOfColumn[r.FirstId].Label}", Indirect: !r.IsForeignKey))
                .OrderBy(r => r.Label, StringComparer.CurrentCultureIgnoreCase).ToList();
        }
    }

    private async Task SetShowNeighborsAsync(bool on)
    {
        if (CurrentDomain is not { } domain) return;
        await SaveDomainSettingsAsync(domain, showNeighbors: on);
