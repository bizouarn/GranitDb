    private async Task ToggleRelationAsync(string relationId, bool shown)
    {
        if (CurrentDomain is not { } domain) return;
        var hidden = domain.HiddenRelations.ToHashSet();
        if (shown) hidden.Remove(relationId);
        else hidden.Add(relationId);
        await SaveDomainSettingsAsync(domain, hiddenRelations: hidden);
    }

