    private async Task LoadTablesAsync()
    {
        _tables = _database == null ? [] : (await Api.GetTablesAsync(Id)).OrderBy(t => t.Name).ToArray();
        _columnLabels = _tables.SelectMany(t => t.Columns.Select(c => (c.Id, Label: $"{t.Name}.{c.Name}")))
            .ToDictionary(x => x.Id, x => x.Label);
        _columnTables = _tables.SelectMany(t => t.Columns.Select(c => (c.Id, TableId: t.Id)))
            .ToDictionary(x => x.Id, x => x.TableId);
    }

    /// <summary>Complétude, étiquettes et domaines : des compléments, leur absence n'empêche pas d'afficher la base.</summary>
    private async Task LoadGovernanceAsync()
    {
        if (_database == null) return;
        var links = Api.GetTagLinksAsync(Id);
        var domains = Api.GetDomainsAsync(Id);
        var completeness = Api.GetCompletenessAsync(Id);
        await Task.WhenAll(links, domains, completeness);
        _tagLinks = links.Result;
        _domains = domains.Result;
        _completeness = completeness.Result;
    }

    private async Task RefreshCompletenessAsync()
    {
        _completeness = await Api.GetCompletenessAsync(Id);
    }

    private string Label(string columnId)
    {
        return _columnLabels.GetValueOrDefault(columnId, columnId);
    }

    /// <summary>Une colonne qui ouvre sa table (et la met en évidence) : une relation mène à ses deux tables.</summary>
    private RenderFragment ColumnLink(string columnId) => builder =>
    {
        if (!_columnTables.TryGetValue(columnId, out var tableId))
        {
            builder.AddContent(0, Label(columnId));
            return;
        }

        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "class", "relation-link");
        builder.AddAttribute(3, "href", $"/databases/{Uri.EscapeDataString(Id)}/tables/{Uri.EscapeDataString(tableId)}?column={Uri.EscapeDataString(columnId)}");
        builder.AddContent(4, Label(columnId));
        builder.CloseElement();
    };

    private RenderFragment Side(IEnumerable<string> columnIds, bool group) => builder =>
    {
        var ids = columnIds.ToList();
        if (group) builder.AddContent(0, "(");
        for (var i = 0; i < ids.Count; i++)
        {
            if (i > 0) builder.AddContent(1, ", ");
            builder.AddContent(2, ColumnLink(ids[i]));
        }

        if (group) builder.AddContent(3, ")");
    };

    private RenderFragment RelationLinks(RelationInfo relation) => builder =>
    {
        var pairs = relation.Pairs().ToList();
        var group = relation.ExtraColumns.Count > 0;
        builder.AddContent(0, Side(pairs.Select(p => p.First), group));
        builder.AddContent(1, " → ");
        builder.AddContent(2, Side(pairs.Select(p => p.Second), group));
    };

    /// <summary>« table.colonne → table.colonne » ; une relation multi-colonnes liste toutes ses paires : « (a, b) → (x, y) ».</summary>
    private string RelationLabel(RelationInfo relation)
    {
        if (relation.ExtraColumns.Count == 0) return $"{Label(relation.FirstId)} → {Label(relation.SecondId)}";
        var pairs = relation.Pairs().ToList();
        return $"({string.Join(", ", pairs.Select(p => Label(p.First)))}) → ({string.Join(", ", pairs.Select(p => Label(p.Second)))})";
    }

    private static Color PercentColor(int percent) => percent >= 80 ? Color.Success : percent >= 40 ? Color.Warning : Color.Error;

    private TagLinkView[] TagsOf(string type, string id)
    {
        if (!ReferenceEquals(_tagSource, _tagLinks))
        {
            _tagSource = _tagLinks;
            _tagIndex = _tagLinks.ToLookup(l => (l.EntityType, l.EntityId));
        }
        return _tagIndex[(type, id)].ToArray();
    }

    private IEnumerable<DomainView> DomainsOf(string tableId)
    {
        if (!ReferenceEquals(_domainSource, _domains))
        {
            _domainSource = _domains;
            _domainIndex = _domains.SelectMany(d => d.Tables.Select(t => (t.TableId, Domain: d))).ToLookup(x => x.TableId, x => x.Domain);
        }
        return _domainIndex[tableId];
    }

    private TableCompleteness? CompletenessOf(string tableId)
    {
        if (!ReferenceEquals(_completenessSource, _completeness))
        {
            _completenessSource = _completeness;
            _completenessIndex = new Dictionary<string, TableCompleteness>();
            foreach (var t in _completeness?.PerTable ?? [])
                _completenessIndex.TryAdd(t.TableId, t);
        }
        return _completenessIndex.GetValueOrDefault(tableId);
    }

