@page "/databases/{Id}"
@page "/databases/{Id}/tables/{TableRoute}"
@implements IDisposable
@using GranitDb.Client.api
@using GranitDb.Client.Components
@using GranitDb.Client.Components.Dialogs
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject Client Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject WorkspaceState Workspace
@inject Notifier Notifier
@inject AuthState Auth
@inject IDialogService Dialogs

<PageTitle>@(Title)</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <PageCrumbs DatabaseId="@Id" DatabaseName="@_database?.Name" TableId="@(Single ? TableRoute : null)" TableName="@SingleTable?.Name"
                ColumnName="@SingleColumnName" />

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_database == null)
    {
        <MudAlert Severity="Severity.Warning">Base introuvable.</MudAlert>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2 db-actions">
            <MudText Typo="Typo.h4">@_database.Name</MudText>
            <MudChip T="string" Size="Size.Small">@_database.Type</MudChip>
            @if (!string.IsNullOrWhiteSpace(_database.SourceLabel) && Auth.IsAdmin)
            {
                <MudText Typo="Typo.caption" Class="source-label" Style="color: var(--mud-palette-text-secondary)">@_database.SourceLabel</MudText>
            }
            <MudSpacer />
            @if (_tables.Length > 0)
            {
                <MudButton Variant="Variant.Outlined" Href="@($"/databases/{Uri.EscapeDataString(Id)}/diagram")"
                           StartIcon="@Icons.Material.Filled.AccountTree">Diagramme</MudButton>
            }
            @if (_database.CanResync && !Single && Auth.CanEdit)
            {
                @if (!string.IsNullOrWhiteSpace(_database.SourceLabel))
                {
                    <MudButton Variant="Variant.Outlined" OnClick="EditConnectionAsync"
                               StartIcon="@Icons.Material.Filled.Link" Class="edit-connection">Modifier la connexion</MudButton>
                }
                <MudButton Variant="Variant.Outlined" OnClick="PreviewSyncAsync" Disabled="_syncing"
                           StartIcon="@Icons.Material.Filled.Sync">Resynchroniser</MudButton>
            }
            @if (!Single && Auth.CanEdit)
            {
                <MudButton Variant="Variant.Outlined" OnClick="NewTableAsync" StartIcon="@Icons.Material.Filled.AddBox" Class="new-table"
                           title="Documenter une table qui n'existe pas dans la source (fichier plat, service, table prévue)">Nouvelle table</MudButton>
            }
            @if (!Single && CanProfile)
            {
                <MudButton Variant="Variant.Outlined" OnClick="ProfileDatabaseAsync" Disabled="_profilingDatabase"
                           StartIcon="@Icons.Material.Filled.QueryStats" Class="profile-database"
                           title="Compte les lignes, les nuls et les valeurs distinctes de chaque colonne, à la source (aucune valeur n'est lue ni gardée)">Profiler les colonnes</MudButton>
            }
            @if (!Single && Auth.CanEdit)
            {
                <MudButton Variant="Variant.Outlined" Href="@($"/databases/{Uri.EscapeDataString(_database.Id)}/documentation")"
                           StartIcon="@Icons.Material.Filled.AutoAwesome" Class="documentation-assistant"
                           title="Propositions de descriptions (modèle d'IA local) et de colonnes sensibles, à relire avant d'être enregistrées">Assistant de documentation</MudButton>
            }
            @if (!Single && (Auth.CanEdit || CanProfile))
            {
                <MudButton Variant="Variant.Outlined" Href="@($"/databases/{Uri.EscapeDataString(_database.Id)}/relations")"
                           StartIcon="@Icons.Material.Filled.AccountTree" Class="relation-suggestions"
                           title="Relations que le schéma ne déclare pas, détectées par le nom des colonnes et vérifiées par des comptes">Relations suggérées</MudButton>
            }
            @if (_database.Type == "Sqlite" && !Single && Auth.CanEdit)
            {
                <label class="replace-file">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_syncing" Class="replace-file-button">Remplacer le fichier</MudButton>
                    <InputFile OnChange="PreviewReplaceAsync" accept=".db,.sqlite,.sqlite3,.db3" class="replace-file-input" aria-label="Remplacer le fichier SQLite de cette base" />
                </label>
            }
        </MudStack>

        @if (!Single && _database.CanResync && (Auth.IsAdmin || _database.SyncIntervalMinutes != null || _database.LastSyncAt != null))
        {
            <div class="sync-schedule mb-3">
                <NativeSelect Label="Synchronisation automatique" Value="@(_database.SyncIntervalMinutes?.ToString() ?? "0")" ValueChanged="SetScheduleAsync"
                              Class="field-schedule">
                    <option value="0" disabled="@(!Auth.IsAdmin)">Désactivée</option>
                    @foreach (var (minutes, label) in ScheduleChoices)
                    {
                        <option value="@minutes" disabled="@(!Auth.IsAdmin)">@label</option>
                    }
                </NativeSelect>
                @if (_database.LastSyncAt != null)
                {
                    <MudText Typo="Typo.caption" Class="sync-status" Style="@(_database.LastSyncOk == false ? "color: var(--mud-palette-error)" : "color: var(--mud-palette-text-secondary)")">
                        Dernière synchronisation : @_database.LastSyncAt.Value.ToLocalTime().ToString("g")
                        @(_database.LastSyncOk == false ? $"— échec : {_database.LastSyncError}" : "— réussie")
                    </MudText>
                }
            </div>
        }

        @if (!Single)
        {
            <div class="mb-3 d-flex justify-end gap-2">
                @* Un seul menu pour les trois formats d'export. *@
                <MudMenu Label="Exporter" StartIcon="@Icons.Material.Filled.Download" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         Size="Size.Small" Variant="Variant.Outlined" Dense="true" Class="export-menu" aria-label="Exporter la documentation">
                    <MudMenuItem OnClick="ExportHtmlAsync" Class="export-html">HTML autonome (documentation complète)</MudMenuItem>
                    <MudMenuItem OnClick="ExportMarkdownAsync" Class="export-markdown">Markdown</MudMenuItem>
                    <MudMenuItem OnClick="ExportCsvAsync" Class="export-csv">CSV (dictionnaire des colonnes)</MudMenuItem>
                    <MudMenuItem OnClick="ExportXlsxAsync" Class="export-xlsx">Excel (.xlsx : tables, colonnes, relations, index)</MudMenuItem>
                    <MudMenuItem OnClick="ExportPdfAsync" Class="export-pdf">PDF (version imprimable à enregistrer)</MudMenuItem>
                </MudMenu>
                @if (Auth.CanEdit)
                {
                    <DeleteDatabaseButton Database="_database" Size="Size.Small" />
                }
            </div>
        }

        @if (!Single)
        {
            <div class="mb-2">
                <InlineText Value="@_database.Description" Placeholder="Décrire cette base" Label="Description"
                            OnSave="SaveDatabaseDescriptionAsync" />
            </div>
            <div class="mb-3">
                <TagEditor Tags="TagsOf(TagKind.Database, _database.Id)" OnAdd="name => AddTagAsync(name, TagKind.Database, _database.Id)"
                           OnRemove="RemoveTagAsync" />
            </div>
        }

        @if (!Single && _completeness is { } overall && (overall.Tables > 0))
        {
            <MudPaper Class="pa-3 mb-3" id="completeness">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Documentation</MudText>
                    <MudProgressLinear Value="overall.Percent" Color="@PercentColor(overall.Percent)" Class="flex-grow-1" Rounded="true" />
                    <MudText Typo="Typo.subtitle2" Class="completeness-percent">@overall.Percent %</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                    @overall.TablesDescribed / @overall.Tables table(s) et @overall.ColumnsDescribed / @overall.Columns colonne(s) décrites.
                </MudText>
                @if (overall.SensitiveUndescribed > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 sensitive-warning">
                        @overall.SensitiveUndescribed colonne(s) sensible(s) sans description : à documenter en priorité.
                    </MudAlert>
                }
            </MudPaper>
        }

        @if (_message != null)
        {
            <MudAlert Severity="@_messageSeverity" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _message = null">@_message</MudAlert>
        }

        @if (_preview != null)
        {
            <MudPaper Class="pa-3 mb-3" id="sync-preview">
                <MudText Typo="Typo.h6">@(_pendingFile == null ? "Aperçu de la synchronisation" : $"Aperçu du remplacement par {_pendingName}")</MudText>
                @if (!_preview.HasChanges)
                {
                    <MudText Class="mt-1">Le catalogue est déjà à jour : la source n'a pas changé.</MudText>
                    <MudButton Size="Size.Small" Class="mt-2" OnClick="ClosePreview">Fermer</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-1">
                        @Phrases.SyncSummary(_preview.Changes.Select(c => (c.Kind, c.Action)))
                    </MudText>
                    @if (_preview.LosesDocumentation > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2 loses-documentation">
                            @Phrases.LosingDocumentation(_preview.LosesDocumentation)
                        </MudAlert>
                    }
                    <MudSimpleTable Dense="true" Style="max-height: 40vh; overflow: auto;">
                        <thead><tr><th></th><th>Élément</th><th>Détail</th></tr></thead>
                        <tbody>
                        @foreach (var change in _preview.Changes)
                        {
                            <tr class="@($"change change-{change.Action}")">
                                <td>@ActionSign(change.Action)</td>
                                <td>
                                    @KindLabel(change.Kind) <strong>@Describe(change)</strong>
                                    @if (change.LosesDocumentation)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" Title="Documentation perdue" />
                                    }
                                </td>
                                <td>@change.Detail</td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplySyncAsync" Disabled="_syncing">@(_pendingFile == null ? "Appliquer la synchronisation" : "Remplacer le fichier et synchroniser")</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="ClosePreview" Disabled="_syncing">Annuler</MudButton>
                    </MudStack>
                }
            </MudPaper>
        }

        @if (!Single)
        {
        <ActiveFilterBar Description="@TableFilterDescription" Result="@($"{Visible.Count()} table(s) sur {_tables.Length}")" OnClear="ClearTableFilter" />
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudTextField @bind-Value="_filter" Label="Filtrer les tables" Immediate="true" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="flex-grow-1" />
            @if (_domains.Length > 0)
            {
                <NativeSelect Label="Domaine" Value="@_domainFilter" ValueChanged="@(v => _domainFilter = v)" Class="domain-filter">
                    <option value="">Tous les domaines</option>
                    @foreach (var domain in _domains)
                    {
                        <option value="@domain.Id">@domain.Name</option>
                    }
                </NativeSelect>
            }
        </MudStack>
        }

        @if (_tables.Length == 0)
        {
            <MudText Style="color: var(--mud-palette-text-secondary)">Aucune table dans cette base.</MudText>
        }
        else if (Single && !Visible.Any())
        {
            <MudAlert Severity="Severity.Warning">Table introuvable dans cette base.</MudAlert>
        }
        else
        {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (var table in Shown)
                {
                    <MudExpansionPanel Expanded="@_open.Contains(table.Id)" ExpandedChanged="@(open => SetOpen(table.Id, open))" id="@($"t-{table.Id}")">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.subtitle1">@table.Name</MudText>
                                @if (table.TableType != "Table")
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@table.TableType</MudChip>
                                }
                                @if (table.IsManual)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="table-manual" title="Saisie à la main : la synchronisation la conserve">saisie à la main</MudChip>
                                }
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@table.Columns.Count colonnes</MudText>
                                @if (CompletenessOf(table.Id) is { } done)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@PercentColor(done.Percent)" Class="table-percent">@done.Percent %</MudChip>
                                }
                                @foreach (var domain in DomainsOf(table.Id))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="table-domain">@domain.Name</MudChip>
                                }
                                @foreach (var tag in TagsOf(TagKind.Table, table.Id))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.LocalOffer">@tag.TagName</MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @if (_open.Contains(table.Id))
                            {
                            <div class="mb-1">
                                <InlineText Value="@table.Description" Placeholder="Décrire cette table" Label="Description"
                                            OnSave="@(text => SaveTableDescriptionAsync(table, text))" />
                                <SuggestButton Enabled="CanSuggest" DatabaseId="@Id" TargetType="table" TargetId="@table.Id" Description="@table.Description"
                                               OnAccepted="@(text => SuggestionAcceptedAsync(table, null, text))" />
                            </div>
                            <div class="mb-1">
                                <InlineText Value="@table.MetaInfo" Placeholder="Ajouter des notes" Label="Notes"
                                            OnSave="@(text => SaveTableNotesAsync(table, text))" />
                            </div>
                            <div class="mb-2">
                                <TagEditor Tags="TagsOf(TagKind.Table, table.Id)" OnAdd="name => AddTagAsync(name, TagKind.Table, table.Id)"
                                           OnRemove="RemoveTagAsync" />
                            </div>

                            @if (Auth.CanEdit)
                            {
                                <div class="mb-2">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditColumnsAsync(table))" StartIcon="@Icons.Material.Filled.TableRows" Class="edit-columns">
                                        @(table.IsManual ? "Ajouter / modifier des colonnes" : "Décrire les colonnes en lot")
                                    </MudButton>
                                </div>
                            }

                            @if (table.TableType == "Table" && (CanProfile || _profiles.ContainsKey(table.Id)))
                            {
                                <div class="profile-bar mb-2">
                                    @if (_profiles.TryGetValue(table.Id, out var tableProfile) && tableProfile.ProfiledAt != null)
                                    {
                                        <MudText Typo="Typo.caption" Class="profile-summary" Style="color: var(--mud-palette-text-secondary)">
                                            Profil : @tableProfile.RowCount?.ToString("N0", FrenchNumbers) ligne(s), calculé le @tableProfile.ProfiledAt.Value.ToLocalTime().ToString("g")
                                        </MudText>
                                    }
                                    @if (CanProfile)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ProfileTableAsync(table))"
                                                   Disabled="@_profiling.Contains(table.Id)" StartIcon="@Icons.Material.Filled.QueryStats" Class="profile-table">
                                            @(_profiles.ContainsKey(table.Id) ? "Actualiser le profil" : "Profiler la table")
                                        </MudButton>
                                    }
                                </div>
                            }
                            <MudSimpleTable Dense="true" Hover="true" Style="overflow-x: auto;">
                                <thead>
                                <tr><th>Colonne</th><th>Type</th><th>Null</th><th>Défaut</th>@if (_profiles.ContainsKey(table.Id)) {<th>Profil</th>}<th>Description</th><th>Étiquettes</th><th></th></tr>
                                </thead>
                                <tbody>
                                @foreach (var column in table.Columns.OrderBy(c => c.Position))
                                {
                                    <tr id="@($"c-{column.Id}")" data-column="@column.Name" class="@(string.Join(' ', new[] { column.IsSensitive ? "column-sensitive" : null, column.Id == ColumnId ? "column-focus" : null }.Where(c => c != null)))">
                                        <td>
                                            @if (column.IsPrimaryKey)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Title="Clé primaire" />
                                            }
                                            @column.Name
                                        </td>
                                        <td>@column.DataType</td>
                                        <td>@(column.IsNullable ? "oui" : "non")</td>
                                        <td>@column.DefaultValue</td>
                                        @if (_profiles.ContainsKey(table.Id))
                                        {
                                            <td class="column-profile">
                                                @if (ProfileOf(table.Id, column.Id) is { } p)
                                                {
                                                    <span title="@RowsTitle(p)">@ProfileText(p)</span>
                                                    @if (ProfileKindLabel(p.Kind) is { Length: > 0 } label)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="profile-kind">@label</MudChip>
                                                    }
                                                }
                                            </td>
                                        }
                                        <td>
                                            <InlineText Value="@column.Description" Placeholder="Décrire" Label="@($"Description de {column.Name}")"
                                                        OnSave="@(text => SaveColumnDescriptionAsync(column, text))" />
                                            <SuggestButton Enabled="CanSuggest && !column.IsSensitive" DatabaseId="@Id" TargetType="column" TargetId="@column.Id" Description="@column.Description"
                                                           OnAccepted="@(text => SuggestionAcceptedAsync(table, column, text))" />
                                            @if (_notesOpen.Contains(column.Id) || !string.IsNullOrWhiteSpace(column.MetaInfo))
                                            {
                                                <div class="column-notes">
                                                    <InlineText Value="@column.MetaInfo" Placeholder="Ajouter des notes" Label="@($"Notes de {column.Name}")"
                                                                OnSave="@(text => SaveColumnNotesAsync(column, text))" />
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <TagEditor Tags="TagsOf(TagKind.Column, column.Id)" OnAdd="name => AddTagAsync(name, TagKind.Column, column.Id)"
                                                       OnRemove="RemoveTagAsync" />
                                        </td>
                                        <td style="white-space: nowrap;">
                                            <MudIconButton Icon="@(column.IsSensitive ? Icons.Material.Filled.Shield : Icons.Material.Outlined.Shield)"
                                                           Size="Size.Small" Color="@(column.IsSensitive ? Color.Warning : Color.Default)"
                                                           Class="sensitive-toggle" aria-pressed="@(column.IsSensitive ? "true" : "false")"
                                                           Title="@(column.IsSensitive ? "Données sensibles : cliquer pour démarquer" : "Marquer comme données sensibles")"
                                                           aria-label="@($"Colonne sensible : {column.Name}")"
                                                           OnClick="@(() => ToggleSensitiveAsync(column))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.StickyNote2" Size="Size.Small" Class="notes-toggle"
                                                           Title="Notes" aria-label="@($"Notes de {column.Name}")"
                                                           OnClick="@(() => ToggleNotes(column.Id))" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>

                            @if (table.Indexes.Count > 0)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-3">Index</MudText>
                                <MudList T="string" Dense="true">
                                    @foreach (var index in table.Indexes)
                                    {
                                        <MudListItem T="string">
                                            @index.Name (@index.ColumnNames)
                                            @if (index.IsUnique)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info">unique</MudChip>
                                            }
                                        </MudListItem>
                                    }
                                </MudList>
                            }

                            <MudText Typo="Typo.subtitle2" Class="mt-3">Relations</MudText>
                            <MudList T="string" Dense="true">
                                @foreach (var relation in table.Relations)
                                {
                                    <MudListItem T="string">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="relation-row" data-relation="@relation.Id">
                                            <span class="relation-label">@RelationLinks(relation)@(" ")</span>
                                            @if (_editingRelation == relation.Id)
                                            {
                                                <NativeSelect AriaLabel="Type de la relation" Value="@relation.RelationType" ValueChanged="@(type => ChangeRelationTypeAsync(relation, type))"
                                                              AutoFocus="true" OnBlur="@(() => _editingRelation = null)" Class="relation-type">
                                                    @foreach (var type in RelationTypes)
                                                    {
                                                        <option value="@type">@type</option>
                                                    }
                                                </NativeSelect>
                                            }
                                            else
                                            {
                                                @* Même geste que les textes : un clic ouvre le champ, le choix s'enregistre, quitter le champ le referme. *@
                                                <button type="button" class="relation-edit" title="Cliquer pour modifier le type"
                                                        aria-label="@($"Type de la relation : {relation.RelationType}. Cliquer pour modifier")"
                                                        @onclick="@(() => _editingRelation = relation.Id)">(@relation.RelationType)<MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="relation-pencil" /></button>
                                            }
                                            @if (relation.MetaInfo != RelationAutoMarker)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" title="@Glossary.Define("relation-manuelle")">manuelle</MudChip>
                                            }
                                            @if (relation.MetaInfo != RelationAutoMarker)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" Class="relation-modify"
                                                               Title="Modifier la relation (colonnes, type, description)" aria-label="Modifier la relation"
                                                               OnClick="@(() => OpenRelationDialogAsync(table, relation))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="relation-delete"
                                                               Title="Supprimer la relation" aria-label="Supprimer la relation"
                                                               OnClick="@(() => DeleteRelationAsync(relation))" />
                                            }
                                        </MudStack>
                                        <div class="relation-description">
                                            <InlineText Value="@relation.Description" Multiline="false" Placeholder="Ajouter une description de la relation"
                                                        Label="Description de la relation" OnSave="@RelationDescriptionHandler(relation)" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                            @if (table.Relations.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">Aucune relation : ajoutez-en une pour dire quelle colonne pointe vers quelle table.</MudText>
                            }

                            <MudButton Size="Size.Small" Class="mt-1 relation-add" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => OpenRelationDialogAsync(table))">Ajouter une relation</MudButton>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
            @if (!Single && _visibleCount > _limit)
            {
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-3" Spacing="2">
                    <MudText Typo="Typo.caption">@_limit sur @_visibleCount tables affichées</MudText>
                    <MudButton Variant="Variant.Outlined" Class="show-more" OnClick="@(() => _limit += PageSize)">Afficher plus</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => _limit = int.MaxValue)">Tout afficher</MudButton>
                </MudStack>
            }
        }
    }
</MudContainer>

@code {
    private static class TagKind
    {
        public const string Database = "database";
        public const string Table = "table";
        public const string Column = "column";
    }

    private const string RelationAutoMarker = "auto:fk";
    private static readonly string[] RelationTypes = ["One-to-One", "One-to-Many", "Many-to-Many"];

    [Parameter] public string Id { get; set; } = "";

    /// <summary>Table à déplier à l'ouverture (lien depuis un résultat de recherche).</summary>
    [SupplyParameterFromQuery(Name = "table")] public string? TableId { get; set; }

    /// <summary>Table affichée seule (onglet d'une table : /databases/{id}/tables/{table}).</summary>
    [Parameter] public string? TableRoute { get; set; }

    /// <summary>Colonne mise en évidence (lien depuis l'explorateur ou la palette).</summary>
    [SupplyParameterFromQuery(Name = "column")] public string? ColumnId { get; set; }

    private DatabaseView? _database;
    private TableInfo[] _tables = [];
    private Dictionary<string, string> _columnLabels = new();
    private Dictionary<string, string> _columnTables = new();
    private TagLinkView[] _tagLinks = [];
    private DomainView[] _domains = [];
    private CompletenessReport? _completeness;
    private SyncPreview? _preview;
    private readonly HashSet<string> _open = [];
    private readonly HashSet<string> _notesOpen = [];
    private readonly Dictionary<string, TableProfileView> _profiles = new();
    private readonly HashSet<string> _profiling = [];
    private CapabilitiesView _capabilities = new() { AllowSqlServerSources = false, AllowLocalPaths = false, AllowProfiling = false };
    private string? _scrollTo;
    private const int PageSize = 50;
    private int _limit = PageSize;
    private int _visibleCount;
    private string? _filterText;
    private string _domainFilterValue = "";

    // Filtrer ou changer de domaine repart d'une première page : on ne rend jamais des centaines de panneaux d'un coup.
    private string? _filter
    {
        get => _filterText;
        set { _filterText = value; _limit = PageSize; }
    }

    private string _domainFilter
    {
        get => _domainFilterValue;
        set { _domainFilterValue = value; _limit = PageSize; }
    }

    // Index des compléments, reconstruits seulement quand le tableau source est remplacé (évite un balayage par table).
    private TagLinkView[]? _tagSource;
    private ILookup<(string, string), TagLinkView> _tagIndex = Array.Empty<TagLinkView>().ToLookup(l => (l.EntityType, l.EntityId));
    private DomainView[]? _domainSource;
    private ILookup<string, DomainView> _domainIndex = Array.Empty<DomainView>().ToLookup(d => d.Id);
    private CompletenessReport? _completenessSource;
    private Dictionary<string, TableCompleteness> _completenessIndex = new();
    private bool _loading = true;
    private bool _syncing;
    private string? _message;
    private Severity _messageSeverity = Severity.Info;

    private string? _editingRelation;
    private bool Single => TableRoute != null;

    private TableInfo? SingleTable => TableRoute == null ? null : _tables.FirstOrDefault(t => t.Id == TableRoute);

    private string Title => Single ? SingleTable?.Name ?? "Table" : _database?.Name ?? "Base";

    /// <summary>La colonne mise en évidence (?column=) dans l'onglet d'une table : dernier maillon du fil d'Ariane.</summary>
    private string? SingleColumnName => Single && ColumnId != null
        ? SingleTable?.Columns?.FirstOrDefault(c => c.Id == ColumnId)?.Name
        : null;

    /// <summary>Page de tables réellement rendue (les tables dépliées par un lien en font toujours partie).</summary>
    private IEnumerable<TableInfo> Shown
    {
        get
        {
            var all = Visible.ToList();
            _visibleCount = all.Count;
            if (Single || _limit == int.MaxValue) return all;
            return all.Where((t, i) => i < _limit || _open.Contains(t.Id));
        }
    }

    private string? TableFilterDescription
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(_filter)) parts.Add($"nom contient « {_filter.Trim()} »");
            if (_domainFilter != "") parts.Add($"domaine {_domains.FirstOrDefault(d => d.Id == _domainFilter)?.Name ?? "inconnu"}");
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }

    private void ClearTableFilter()
    {
        _filter = null;
        _domainFilter = "";
    }

    private IEnumerable<TableInfo> Visible
    {
        get
        {
            if (Single) return _tables.Where(t => t.Id == TableRoute);
            var tables = string.IsNullOrWhiteSpace(_filter)
                ? _tables.AsEnumerable()
                : _tables.Where(t => t.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase));
            if (_domainFilter == "") return tables;
            var members = _domains.FirstOrDefault(d => d.Id == _domainFilter)?.Tables.Select(t => t.TableId).ToHashSet() ?? [];
            return tables.Where(t => members.Contains(t.Id));
        }
    }

    protected override void OnInitialized()
    {
        Workspace.CatalogChanged += OnCatalogChanged;
    }

    public void Dispose()
    {
        Workspace.CatalogChanged -= OnCatalogChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _database = await Api.GetDatabaseAsync(Id);
        _capabilities = await Api.GetCapabilitiesAsync();
        await LoadTablesAsync();
        await LoadGovernanceAsync();
        if (Single && SingleTable != null)
        {
            _open.Add(SingleTable.Id);
            if (!string.IsNullOrEmpty(ColumnId)) _scrollTo = $"c-{ColumnId}";
        }
        else if (!string.IsNullOrEmpty(TableId) && _tables.Any(t => t.Id == TableId))
        {
            _open.Add(TableId);
            _scrollTo = $"t-{TableId}";
        }

        if (_database != null) Workspace.Describe(Navigation.Uri, Title);
        _loading = false;
        foreach (var opened in _open.ToList()) _ = LoadProfileAsync(opened);
    }

    /// <summary>Le catalogue a été modifié ailleurs (panneau de détail, autre onglet) : on relit sans clignoter.</summary>
    private void OnCatalogChanged(string? databaseId, object? source)
    {
        if (ReferenceEquals(source, this) || (databaseId != null && databaseId != Id) || _database == null) return;
        _ = InvokeAsync(async () =>
        {
            _database = await Api.GetDatabaseAsync(Id) ?? _database;
            await LoadTablesAsync();
            await LoadGovernanceAsync();
            StateHasChanged();
        });
    }

    private void Changed() => Workspace.NotifyCatalogChanged(Id, this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollTo == null || _loading) return;
        var target = _scrollTo;
        _scrollTo = null;
        try
        {
            await JS.InvokeVoidAsync("granitdb.scrollToId", target);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException)
        {
            // Défilement impossible : la table reste dépliée.
        }
    }

    private void SetOpen(string tableId, bool open)
    {
        if (open)
        {
            _open.Add(tableId);
            _ = LoadProfileAsync(tableId);
        }
        else _open.Remove(tableId);
    }

    /// <summary>Le profil des colonnes (un complément : son absence n'empêche pas d'afficher la table).</summary>
    private async Task LoadProfileAsync(string tableId)
    {
        if (_profiles.ContainsKey(tableId)) return;
        var profile = await Api.GetTableProfileAsync(tableId);
        if (profile?.ProfiledAt == null) return; // pas encore profilée : rien à montrer
        _profiles[tableId] = profile;
        await InvokeAsync(StateHasChanged);
    }

    private ColumnProfileView? ProfileOf(string tableId, string columnId) =>
        _profiles.TryGetValue(tableId, out var profile) ? profile.Columns.FirstOrDefault(c => c.ColumnId == columnId) : null;

    private bool CanProfile => _capabilities.AllowProfiling && Auth.IsAdmin;

    private bool CanSuggest => _capabilities.AllowAi && Auth.CanEdit;

    /// <summary>Une proposition acceptée a déjà été écrite par l'API : on met le modèle de la page à jour.</summary>
    private async Task SuggestionAcceptedAsync(TableInfo table, ColumnInfo? column, string text)
    {
        if (column != null) column.Description = text;
        else table.Description = text;
        await AfterSaveAsync();
    }

    private async Task ProfileTableAsync(TableInfo table)
    {
        _profiling.Add(table.Id);
        try
        {
            _profiles[table.Id] = await Api.ProfileTableAsync(table.Id);
            Notifier.Show($"Profil de {table.Name} calculé.");
        }
        catch (ApiException e)
        {
            (_message, _messageSeverity) = (e.Message, Severity.Error);
        }
        finally
        {
            _profiling.Remove(table.Id);
        }
    }

    private async Task ProfileDatabaseAsync()
    {
        _profilingDatabase = true;
        try
        {
            var run = await Api.ProfileDatabaseAsync(Id);
            _profiles.Clear();
            foreach (var id in _open.ToList()) await LoadProfileAsync(id);
            var more = run.TablesRemaining > 0 ? $" ; {run.TablesRemaining} restante(s), relancez pour continuer" : "";
            var failed = run.TablesFailed > 0 ? $", {run.TablesFailed} en échec ({string.Join(" ; ", run.Errors.Take(3))})" : "";
            Notifier.Show($"{run.TablesProfiled} table(s) profilée(s){failed}{more}.", run.TablesFailed > 0 ? Severity.Warning : Severity.Success);
        }
        catch (ApiException e)
        {
            (_message, _messageSeverity) = (e.Message, Severity.Error);
        }
        finally
        {
            _profilingDatabase = false;
        }
    }

    private bool _profilingDatabase;

