    private async Task ChangeRelationTypeAsync(RelationInfo relation, string type)
    {
        var previous = relation.RelationType;
        try
        {
            await Api.UpdateRelationTypeAsync(relation, type);
            relation.RelationType = type;
            _editingRelation = null;
            Changed();
            if (previous != type)
                Notifier.Show("Type de la relation modifié.", Severity.Success, async () =>
                {
                    await Api.UpdateRelationTypeAsync(relation, previous);
                    relation.RelationType = previous;
                    Changed();
                    await InvokeAsync(StateHasChanged);
                });
        }
        catch (ApiException ex)
        {
            ShowError(ex.Message);
        }
    }

    private async Task DeleteRelationAsync(RelationInfo relation)
    {
        try
        {
            await Api.DeleteRelationAsync(relation.Id);
            await LoadTablesAsync();
            Changed();
            // Annuler recrée la relation (avec un nouvel identifiant).
            Notifier.Show("Relation supprimée.", Severity.Success, async () =>
            {
                await Api.CreateRelationAsync(relation.FirstId, relation.SecondId, relation.RelationType, relation.Description,
                    relation.ExtraColumns);
                await LoadTablesAsync();
                Changed();
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (ApiException ex)
        {
            ShowError(ex.Message);
        }
    }

