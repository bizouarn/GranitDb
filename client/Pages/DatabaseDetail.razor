    /// <summary>Nombres à la française quelle que soit la culture de la machine (milliers : espace fine insécable).</summary>
    private static readonly System.Globalization.NumberFormatInfo FrenchNumbers = new()
    {
        NumberGroupSeparator = " ",
        NumberDecimalSeparator = ","
    };

    private static string RowsTitle(ColumnProfileView p) => p.RowCount.ToString("N0", FrenchNumbers) + " ligne(s) au moment du profilage";

    /// <summary>« 60 % de nuls · 2 valeurs » : ce que le profil dit d'une colonne, en une ligne.</summary>
    private static string ProfileText(ColumnProfileView p)
    {
        var nulls = p.NullRatio == 0 ? "aucun nul" : $"{(p.NullRatio * 100).ToString("0.#", FrenchNumbers)} % de nuls";
        var distinct = p.DistinctCount == null ? "" : p.DistinctCount == 1 ? " · 1 valeur" : $" · {p.DistinctCount.Value.ToString("N0", FrenchNumbers)} valeurs";
        return nulls + distinct;
    }

    private static string ProfileKindLabel(string kind) => kind switch
    {
        "unique" => "unique",
        "constant" => "constante",
        "low" => "peu de valeurs",
        "high" => "variée",
