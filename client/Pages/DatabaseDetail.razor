    private async Task PreviewSyncAsync()
    {
        _syncing = true;
        try
        {
            _message = null;
            _preview = await Api.PreviewSyncAsync(Id);
        }
        catch (ApiException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _syncing = false;
        }
    }

    private void ClosePreview()
    {
        _preview = null;
        _pendingFile = null;
    }

    private const long MaxReplaceSize = 100L * 1024 * 1024;
    private byte[]? _pendingFile;
    private string _pendingName = "";

    /// <summary>Un fichier est choisi : on montre ce qu'il changerait avant de le remplacer. Le fichier reste en mémoire jusqu'à l'application.</summary>
    private async Task PreviewReplaceAsync(InputFileChangeEventArgs e)
    {
        _syncing = true;
        try
        {
            _message = null;
            await using var stream = e.File.OpenReadStream(MaxReplaceSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            _preview = await Api.PreviewReplaceSqliteAsync(Id, bytes, e.File.Name);
            _pendingFile = bytes;
            _pendingName = e.File.Name;
        }
        catch (ApiException ex)
        {
            ShowError(ex.Message);
        }
        catch (IOException)
        {
            ShowError("Fichier trop volumineux (100 Mo maximum).");
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task ApplySyncAsync()
    {
        _syncing = true;
        try
        {
            var summary = _pendingFile == null
                ? await Api.SyncAsync(Id)
                : (await Api.ReplaceSqliteAsync(Id, _pendingFile, _pendingName)).Sync;
            _preview = null;
            _pendingFile = null;
            await LoadTablesAsync();
            await LoadGovernanceAsync();
            Changed();
            Notifier.Show($"Synchronisé : {summary.TablesAdded} table(s) ajoutée(s), {summary.TablesRemoved} supprimée(s), {summary.ColumnsAdded} colonne(s) ajoutée(s), {summary.IndexesAdded} index ajouté(s).");
        }
        catch (ApiException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _syncing = false;
        }
    }

    private void ShowError(string message)
    {
        _message = message;
        _messageSeverity = Severity.Error;
    }

