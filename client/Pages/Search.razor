@page "/search"
@using GranitDb.Client.Components
@using GranitDb.Client.api
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject Client Api
@inject NavigationManager Navigation
@inject WorkspaceState Workspace

<PageShell Title="Recherche" TabTitle="@TabTitle">

    @if (string.IsNullOrWhiteSpace(Q) || Q.Trim().Length < 2)
    {
        <Muted Typo="Typo.body1">Saisissez au moins 2 caractères dans la barre de recherche, puis validez avec Entrée.</Muted>
        <div class="search-examples" aria-label="Exemples de recherche">
            <span>Essayez :</span>
            @foreach (var example in Examples)
            {
                <a class="search-example" href="@($"/search?q={Uri.EscapeDataString(example)}")">@example</a>
            }
        </div>
    }
    else if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_error != null)
    {
        <MudAlert Severity="Severity.Warning">@_error</MudAlert>
    }
    else if (_hits.Length == 0)
    {
        <Muted Typo="Typo.body1">Aucun résultat pour « @Q ». Essayez un mot plus court, ou une partie du nom d'une table ou d'une colonne.</Muted>
    }
    else if (_scope != null && Shown.Length == 0)
    {
        <Muted Typo="Typo.body1" Class="search-scope-empty">Aucun résultat pour « @Q » dans la base courante.</Muted>
        <MudButton Variant="Variant.Outlined" Class="search-widen" OnClick="@(() => _scope = null)">Chercher dans toutes les bases (@_hits.Length)</MudButton>
    }
    else
    {
        @if (DatabasesInHits.Count > 1)
        {
            <div class="search-scope" role="group" aria-label="Limiter à une base">
                <button type="button" class="@ScopeClass(null)" aria-pressed="@(_scope == null ? "true" : "false")" @onclick="() => _scope = null">Toutes les bases (@_hits.Length)</button>
                @foreach (var (id, name, count) in DatabasesInHits)
                {
                    var scopeId = id;
                    <button type="button" class="@ScopeClass(id)" aria-pressed="@(_scope == id ? "true" : "false")" @onclick="() => _scope = scopeId">@name (@count)</button>
                }
            </div>
        }
        <Muted Typo="Typo.body1" Class="mb-3">@Shown.Length résultat(s) pour « @Q »</Muted>
        @foreach (var group in Groups)
        {
            <MudText Typo="Typo.h6" Class="mt-4">@group.Label (@group.Hits.Count)</MudText>
            <MudList T="string" Dense="true" Class="search-results">
                @foreach (var hit in group.Hits)
                {
                    <MudListItem T="string" Href="@hit.Href">
                        <MudText>@hit.Name</MudText>
                        <Muted Typo="Typo.caption">@Context(hit) · <span class="match-reason">@hit.MatchReason(Q)</span></Muted>
                        @if (!string.IsNullOrWhiteSpace(hit.Description))
                        {
                            <MudText Typo="Typo.body2">@hit.Description</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        }
    }
</PageShell>

@code {
    private static readonly (string Kind, string Label)[] Kinds =
        [("database", "Bases"), ("domain", "Domaines"), ("table", "Tables"), ("column", "Colonnes"), ("index", "Index")];


    private SearchHit[] _hits = [];
    private string TabTitle => Q?.Trim() is { Length: >= 2 } term ? $"Recherche : {term}" : "Recherche";

    private bool _loading;
    private string? _scope;

    private static readonly string[] Examples = ["client", "email", "date", "id"];

    private SearchHit[] Shown => _scope == null ? _hits : _hits.Where(h => h.DatabaseId == _scope).ToArray();

    private List<(string Id, string Name, int Count)> DatabasesInHits => _hits
        .GroupBy(h => h.DatabaseId)
        .Select(g => (g.Key, g.First().DatabaseName, g.Count()))
        .OrderByDescending(d => d.Item3).ToList();

    private string ScopeClass(string? id) => _scope == id ? "search-scope-chip active" : "search-scope-chip";
    private string? _error;

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    /// <summary>La base à laquelle la recherche est limitée d'office (celle dont la page est affichée quand on a cherché).</summary>
    [SupplyParameterFromQuery(Name = "db")] public string? Db { get; set; }

    private IEnumerable<(string Label, List<SearchHit> Hits)> Groups => Kinds
        .Select(k => (k.Label, Hits: Shown.Where(h => h.Kind == k.Kind).ToList()))
        .Where(g => g.Hits.Count > 0);

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _hits = [];
        _scope = Db;
        var term = Q?.Trim();
        if (term is not { Length: >= 2 }) return;

        _loading = true;
        try
        {
            _hits = await Api.SearchAsync(term);
        }
        catch (Exception ex) when (ApiErrors.Describe(ex) is { } message)
        {
            _error = message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Context(SearchHit hit)
    {
        return hit.Kind switch
        {
            "database" => "Base",
            "table" => $"Table de {hit.DatabaseName}",
            "column" => $"Colonne de {hit.DatabaseName} › {hit.TableName}",
            _ => $"Index de {hit.DatabaseName} › {hit.TableName}"
        };
    }
}
