@page "/webhooks"
@using GranitDb.Client.api
@using GranitDb.Client.Components
@using GranitDb.Client.Components.Dialogs
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject Client Api
@inject NavigationManager Navigation
@inject WorkspaceState Workspace
@inject Notifier Notifier
@inject IDialogService Dialogs

<PageTitle>Webhooks</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudBreadcrumbs Items="_crumbs" Class="pa-0 mb-2" />
    <MudText Typo="Typo.h4" Class="mb-1">Webhooks</MudText>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary)">
        Une adresse appelée en POST (JSON, signé si un secret est défini) quand un événement survient : changement de schéma,
        base importée ou supprimée. Les adresses locales ou privées sont refusées par défaut.
    </MudText>

    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        @if (_hooks.Length == 0)
        {
            <MudText Typo="Typo.body2" Class="webhooks-empty" Style="color: var(--mud-palette-text-secondary)">Aucun webhook : ajoutez une adresse pour prévenir un outil (intégration, chat, tâche planifiée) quand le schéma change ou qu'une base est importée ou supprimée.</MudText>
        }

        @foreach (var hook in _hooks)
        {
            var current = hook;
            <MudPaper Class="pa-3 mb-2" Outlined="true" data-webhook="@hook.Url">
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.subtitle1" Class="webhook-url">@hook.Url</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@(hook.IsActive ? Color.Success : Color.Default)">@(hook.IsActive ? "actif" : "en pause")</MudChip>
                    @foreach (var name in hook.Events)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@name</MudChip>
                    }
                    @if (hook.HasSecret)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" title="Chaque envoi porte une signature HMAC-SHA256 calculée avec le secret : le destinataire peut vérifier qu'il vient de GranitDb">signé</MudChip>
                    }
                    <MudSpacer />
                    <MudButton Size="Size.Small" OnClick="() => TestAsync(current)" Class="webhook-test">Tester</MudButton>
                    <MudButton Size="Size.Small" OnClick="() => ToggleDeliveriesAsync(current)" Class="webhook-deliveries">Envois</MudButton>
                    <MudButton Size="Size.Small" OnClick="() => EditAsync(current)" Class="webhook-edit">Modifier</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(current)" Class="webhook-delete">Supprimer</MudButton>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(hook.Description) || hook.DatabaseId != null)
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                        @hook.Description@(hook.DatabaseId != null ? $" — base : {DatabaseName(hook.DatabaseId)}" : "")
                    </MudText>
                }
                @if (_testResult.TryGetValue(hook.Id, out var test))
                {
                    <MudAlert Severity="@(test.Success ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2 webhook-test-result">
                        @TestMessage(test)
                    </MudAlert>
                }
                @if (_open == hook.Id)
                {
                    @if (_deliveries.Length == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2 webhook-no-delivery">Aucun envoi.</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Class="mt-2">
                            <thead><tr><th>Date (UTC)</th><th>Événement</th><th>Résultat</th><th>Essais</th></tr></thead>
                            <tbody>
                            @foreach (var delivery in _deliveries)
                            {
                                <tr data-delivery="@delivery.Id">
                                    <td>@delivery.At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@delivery.Event</td>
                                    <td>@DeliveryResult(delivery)</td>
                                    <td>@delivery.Attempts</td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            </MudPaper>
        }

        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync" Class="mt-2 webhook-add">Ajouter un webhook</MudButton>
    }
</MudContainer>

@code {
    private readonly List<BreadcrumbItem> _crumbs = [new("Bases", href: "/"), new("Webhooks", href: null, disabled: true)];
    private WebhookView[] _hooks = [];
    private DatabaseView[] _databases = [];
    private WebhookDelivery[] _deliveries = [];
    private readonly Dictionary<string, WebhookDelivery> _testResult = new();
    private string? _open, _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Describe(Navigation.Uri, "Webhooks");
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _hooks = await Api.GetWebhooksAsync();
            _databases = (await Api.GetAllDatabaseAsync()).OrderBy(d => d.Name, StringComparer.CurrentCultureIgnoreCase).ToArray();
            _error = null;
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Les webhooks n'ont pas pu être lus : l'API ne répond pas.";
        }
    }

    private string DatabaseName(string id) => _databases.FirstOrDefault(d => d.Id == id)?.Name ?? id;

    private static string TestMessage(WebhookDelivery test) =>
        test.Success ? $"Essai réussi (code {test.StatusCode})." : $"Essai échoué : {test.Error ?? $"code {test.StatusCode}"}";

    private static string DeliveryResult(WebhookDelivery delivery) =>
        delivery.Success ? $"réussi ({delivery.StatusCode})" : delivery.Error ?? $"code {delivery.StatusCode}";

    private async Task CreateAsync() => await OpenDialogAsync(null);

    private async Task EditAsync(WebhookView hook) => await OpenDialogAsync(hook);

    /// <summary>Fenêtre de saisie d'un webhook (nouveau, ou modification de celui donné).</summary>
    private async Task OpenDialogAsync(WebhookView? existing)
    {
        var parameters = new DialogParameters<WebhookDialog> { { x => x.Existing, existing }, { x => x.Databases, _databases } };
        if (!await Dialogs.ShowFormAsync(existing == null ? "Nouveau webhook" : "Modifier le webhook", parameters, MaxWidth.Medium)) return;
        Notifier.Show(existing == null ? "Webhook ajouté." : "Webhook modifié.");
        await LoadAsync();
    }

    private async Task DeleteAsync(WebhookView hook)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Supprimer le webhook {hook.Url} ?" },
            { x => x.Consequence, "Il ne recevra plus aucun événement et son historique d'envois est perdu. Cela ne peut pas être annulé." },
            { x => x.ConfirmText, "Supprimer le webhook" }
        };
        if (!await Dialogs.ShowFormAsync("Supprimer un webhook", parameters)) return;
        try
        {
            await Api.DeleteWebhookAsync(hook.Id);
            Notifier.Show("Webhook supprimé.");
            await LoadAsync();
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private async Task TestAsync(WebhookView hook)
    {
        try
        {
            _testResult[hook.Id] = await Api.TestWebhookAsync(hook.Id);
            _error = null;
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }

    private async Task ToggleDeliveriesAsync(WebhookView hook)
    {
        if (_open == hook.Id)
        {
            _open = null;
            return;
        }

        try
        {
            _deliveries = await Api.GetWebhookDeliveriesAsync(hook.Id);
            _open = hook.Id;
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
    }
}
