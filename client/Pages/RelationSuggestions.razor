@page "/databases/{Id}/relations"
@inherits DatabasePageBase
@using GranitDb.Client.Components
@using GranitDb.Client.api
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject NavigationManager Navigation
@inject WorkspaceState Workspace
@inject Notifier Notifier
@inject AuthState Auth

<PageShell Title="Relations suggérées" DatabaseId="@Id" DatabaseName="@_databaseName" Description="Colonnes dont le nom et les valeurs laissent penser qu'elles référencent une autre table, sans clé étrangère déclarée. La détection compte, à la source, les valeurs qui n'existent pas dans la table visée : aucune valeur n'est lue ni gardée. Rien n'est créé sans votre accord." Error="@_error" ErrorChanged="@(v => _error = v)">

    <MudStack Row="true" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        @if (CanDetect)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => DetectAsync(false)" Disabled="_busy" Class="detect-relations"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh">Détecter les relations</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => DetectAsync(true)" Disabled="_busy" Class="detect-relations-values"
                       title="Cherche aussi les colonnes dont le nom ne désigne pas la table visée mais dont les valeurs s'y retrouvent (plus long : chaque rapprochement est testé à la source)."
                       StartIcon="@Icons.Material.Filled.ManageSearch">Détecter aussi par les valeurs</MudButton>
        }
        @if (Auth.CanEdit && _items.Any(s => s.Score >= 75))
        {
            <MudButton Variant="Variant.Outlined" OnClick="AcceptProbableAsync" Disabled="_busy" Class="accept-probable">
                Accepter les @_items.Count(s => s.Score >= 75) probable(s)
            </MudButton>
        }
        @if (_summary != null)
        {
            <MudText Typo="Typo.caption" Class="detect-summary">@_summary</MudText>
        }
    </MudStack>

    <SuggestionsTable TItem="RelationSuggestionView" Items="_items" IdOf="@(s => s.Id)" Loading="_loading" Busy="_busy" EmptyText="@(CanDetect ? "Aucune suggestion en attente. Lancez la détection pour en chercher." : "Aucune suggestion en attente.")" OnAccept="AcceptAsync" OnReject="RejectAsync">
        <Header><th>Colonne</th><th></th><th>Table visée</th><th>Score</th><th>Pourquoi</th></Header>
        <RowContent Context="s">
            <td><code>@s.ChildTable.@s.ChildColumn</code></td>
            <td>→</td>
            <td><code>@s.ParentTable.@s.ParentColumn</code></td>
            <td><Badge Color="@ColorOf(s.Level)" Class="@($"level-{s.Level}")">@s.Level (@s.Score)</Badge></td>
            <td>
                <ul class="suggestion-reasons">
                    @foreach (var reason in s.Reasons)
                    {
                        <li>@reason</li>
                    }
                </ul>
            </td>
        </RowContent>
    </SuggestionsTable>
</PageShell>

@code {
    private List<RelationSuggestionView> _items = [];
    private string? _summary;

    private bool CanDetect => _capabilities.AllowProfiling && Auth.IsAdmin;

    protected override async Task LoadAsync()
    {
        _items = await Api.GetRelationSuggestionsAsync(Id);
    }

    private static Color ColorOf(string level) => level switch
    {
        "probable" => Color.Success,
        "possible" => Color.Warning,
        _ => Color.Default
    };

    private Task DetectAsync(bool byValues) => RunAsync(async () =>
    {
        var run = await Api.DetectRelationsAsync(Id, byValues);
        _items = await Api.GetRelationSuggestionsAsync(Id);
        var failed = run.Failed > 0 ? $", {run.Failed} vérification(s) en échec" : "";
        var skipped = run.Skipped > 0 ? $", {run.Skipped} candidat(s) non vérifié(s) (limite atteinte)" : "";
        var dropped = run.Empty + run.Mismatched > 0 ? $" ({run.Empty} sans assez de valeurs, {run.Mismatched} dont les valeurs ne se retrouvent pas dans la cible)" : "";
        _summary = $"{run.Candidates} candidat(s) par {(byValues ? "le nom et les valeurs" : "le nom")}, {run.Suggested} suggestion(s) retenue(s){dropped}{failed}{skipped}.";
        if (run.Errors.Count > 0) _error = string.Join(" ", run.Errors.Take(3));
    });

    private Task AcceptAsync(RelationSuggestionView s) => RunAsync(async () =>
    {
        await Api.AcceptRelationSuggestionAsync(Id, s.Id);
        _items.Remove(s);
        Workspace.Saved(Notifier, Id, this, $"Relation {s.ChildTable}.{s.ChildColumn} → {s.ParentTable}.{s.ParentColumn} créée.");
    });

    private Task RejectAsync(RelationSuggestionView s) => RunAsync(async () =>
    {
        await Api.RejectRelationSuggestionAsync(Id, s.Id);
        _items.Remove(s);
        Notifier.Show("Suggestion refusée : elle ne sera plus proposée.");
    });

    private Task AcceptProbableAsync() => RunAsync(async () =>
    {
        var batch = await Api.AcceptRelationSuggestionsAsync(Id, 75);
        _items = await Api.GetRelationSuggestionsAsync(Id);
        Notifier.Show($"{batch.Accepted} relation(s) créée(s){(batch.Skipped > 0 ? $", {batch.Skipped} ignorée(s)" : "")}.",
            batch.Skipped > 0 ? Severity.Warning : Severity.Success);
        Workspace.NotifyCatalogChanged(Id, this);
    });
}
