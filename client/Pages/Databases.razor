@page "/"
@page "/databases"
@using GranitDb.Client.api
@using GranitDb.Client.Components
@using GranitDb.Client.Components.Dialogs
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject Client Api
@inject NavigationManager Navigation
@inject WorkspaceState Workspace
@inject Notifier Notifier
@inject AuthState Auth
@inject IDialogService Dialogs
@inject IJSRuntime Js

<PageTitle>Bases documentées</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4">Bases documentées</MudText>

    @if (Auth.CanEdit)
    {
    <MudPaper Class="pa-6 mb-6 dropzone" Outlined="true">
        <InputFile @ref="_dropZone" class="dropzone-input" OnChange="OnFileSelected" accept=".db,.sqlite,.sqlite3,.db3" disabled="@_busy" />
        <MudStack AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" />
            <MudText Typo="Typo.h6">Glissez un fichier SQLite ou H2 (.mv.db) ici, ou cliquez pour le choisir</MudText>
            <Muted>
                Aucun serveur de base de données n'est nécessaire : le schéma est lu directement dans le fichier.
            </Muted>
            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-2" Style="width: 240px" />
            }
        </MudStack>
    </MudPaper>

    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
        <MudButton Variant="Variant.Outlined" OnClick="TrySampleAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.AutoAwesome" Class="try-sample">
            Essayer avec un exemple
        </MudButton>
        @if (!Auth.IsAdmin)
        {
            @* Les sources SQL Server sont réservées aux administrateurs. *@
        }
        else if (_capabilities.AllowSqlServerSources)
        {
            <MudButton Variant="Variant.Outlined" OnClick="ConnectServerAsync" StartIcon="@Icons.Material.Filled.Dns" Class="connect-sqlserver">
                Connecter un serveur (SQL Server, PostgreSQL, MySQL)
            </MudButton>
        }
        else
        {
            <Muted Typo="Typo.caption" Class="sqlserver-disabled">
                Pour documenter une base SQL Server, PostgreSQL ou MySQL, activez Catalog:AllowSqlServerSources sur le serveur de l'API.
            </Muted>
        }
    </MudStack>
    }

    <ErrorAlert Message="@_error" Class="mb-4" OnClose="@(() => _error = null)" />

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_loadError != null)
    {
        <MudAlert Severity="Severity.Warning">@_loadError</MudAlert>
    }
    else if (_databases.Length == 0)
    {
        <Muted Typo="Typo.body1">Aucune base pour le moment. Envoyez un fichier SQLite pour commencer.</Muted>
        <ol class="welcome-steps" aria-label="Pour commencer">
            <li><strong>1. Importez</strong>Déposez un fichier SQLite (ou essayez l'exemple) : tables, colonnes, clés et relations sont lues sans serveur.</li>
            <li><strong>2. Explorez et documentez</strong>Parcourez l'arbre à gauche, cliquez une table ou une colonne et décrivez-la sur place.</li>
            <li><strong>3. Partagez</strong>Ouvrez le diagramme d'un domaine et exportez-le en SVG, PNG ou Mermaid.</li>
        </ol>
        <Muted Typo="Typo.caption">Astuce : @Shortcuts.Palette ouvre la palette de commandes, @Shortcuts.Help affiche tous les raccourcis.</Muted>
    }
    else
    {
        <MudGrid>
            @foreach (var db in _databases)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@db.Name</MudText>
                            <Badge>@db.Type</Badge>
                            @if (!string.IsNullOrWhiteSpace(db.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@db.Description</MudText>
                            }
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/databases/{db.Id}")" Color="Color.Primary">Ouvrir</MudButton>
                            <MudButton Href="@($"/databases/{db.Id}/diagram")">Diagramme</MudButton>
                        </MudCardActions>
                        @if (Auth.CanEdit)
                        {
                            <div class="px-2 pb-2 d-flex justify-end">
                                <DeleteDatabaseButton Database="db" Size="Size.Small" OnDeleted="LoadPageAsync" />
                            </div>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <Pager Skip="_skip" PageSize="PageSize" Total="_total" SkipChanged="GoToAsync" />
    }
</MudContainer>

@code {
    private const int PageSize = 12;

    private InputFile? _dropZone;
    private DatabaseView[] _databases = [];
    private int _skip;
    private int _total;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _loadError;

    private CapabilitiesView _capabilities = new() { AllowSqlServerSources = false, AllowLocalPaths = false };

    protected override async Task OnInitializedAsync()
    {
        _capabilities = await Api.GetCapabilitiesAsync();
        await LoadPageAsync();
        _loading = false;
    }

    private async Task LoadPageAsync()
    {
        try
        {
            var result = await Api.GetDatabasesPageAsync(_skip, PageSize);
            _databases = result.Items;
            _total = result.Total;
            _loadError = null;
        }
        catch (HttpRequestException)
        {
            _loadError = $"{ApiErrors.Unreachable} Vérifiez qu'elle est démarrée et que ApiBaseUrl est correct.";
        }
    }

    private async Task GoToAsync(int skip)
    {
        _skip = skip;
        await LoadPageAsync();
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File.Size > _capabilities.MaxUploadBytes())
        {
            _error = _capabilities.TooLargeMessage();
            return Task.CompletedTask;
        }

        if (e.File.Size > Client.DirectUploadThreshold)
            return ImportAsync(() => Api.UploadFromBrowserAsync<ImportView>(Js, _dropZone!.Element!.Value, HttpMethod.Post, "api/v1/import/sqlite"));
        return ImportAsync(() => { var stream = e.File.OpenReadStream(_capabilities.MaxUploadBytes()); return Api.UploadSqliteAsync(stream, e.File.Name, null, null); });
    }

    private async Task ConnectServerAsync()
    {
        var id = await Dialogs.ShowDataAsync<ImportWizardDialog, string>("Connecter un serveur", new DialogParameters<ImportWizardDialog>(), MaxWidth.Medium);
        if (id != null) Navigation.NavigateTo($"/databases/{id}");
    }

    private Task TrySampleAsync() => ImportAsync(Api.ImportSampleAsync);

    private async Task ImportAsync(Func<Task<ImportView>> import)
    {
        _error = null;
        _busy = true;
        try
        {
            var result = await import();
            Workspace.Saved(Notifier, null, this, $"Base {result.Database.Name} importée : {result.Sync.TablesAdded} table(s), {result.Sync.ColumnsAdded} colonne(s).");
            Navigation.NavigateTo($"/databases/{result.Database.Id}");
        }
        catch (Exception ex) when (ApiErrors.Describe(ex) is { } message)
        {
            _error = message;
        }
        catch (IOException)
        {
            _error = _capabilities.TooLargeMessage();
        }
        finally
        {
            _busy = false;
        }
    }
}
