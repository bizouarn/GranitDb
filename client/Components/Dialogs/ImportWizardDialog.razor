@using GranitDb.Client.api
@using GranitDb.Client.Models
@using GranitDb.Client.Workspace
@inject Client Api
@inject Notifier Notifier
@inject WorkspaceState Workspace

@* Assistant d'import à étapes : type de base → connexion (testée avant de continuer) → schémas, nom et description → récapitulatif.
   Sert aussi à « Modifier la connexion » d'une base (le type est alors figé et le nom/la description ne se redemandent pas). *@
<MudDialog>
    <DialogContent>
        <div class="import-wizard">
            <ol class="wizard-steps" aria-label="Étapes de l'import">
                @for (var i = 0; i < _steps.Count; i++)
                {
                    var index = i;
                    <li class="@StepClass(index)" aria-current="@(index == _step ? "step" : null)">
                        <span class="wizard-step-number">@(index + 1)</span> @_steps[index].Title
                    </li>
                }
            </ol>
            <MudText Typo="Typo.caption" Class="wizard-live" role="status" aria-live="polite">Étape @(_step + 1) sur @_steps.Count : @_steps[_step].Title</MudText>

            @switch (_steps[_step].Key)
            {
                case Step.Source:
                    <MudStack Spacing="2" Class="wizard-source">
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                            GranitDb lit uniquement le <strong>schéma</strong> (tables, colonnes, clés, index), jamais les données.
                            Pour un fichier SQLite, fermez cette fenêtre et déposez-le sur la page des bases.
                        </MudText>
                        <NativeSelect Label="Type de base" Value="@_form.Engine" ValueChanged="SetEngine" Class="field-engine">
                            <option value="@ServerEngines.SqlServer">Microsoft SQL Server</option>
                            <option value="@ServerEngines.PostgreSql">PostgreSQL</option>
                            <option value="@ServerEngines.MySql">MySQL / MariaDB</option>
                        </NativeSelect>
                        <MudText Typo="Typo.body2">@RightHint</MudText>
                    </MudStack>
                    break;

                case Step.Connection:
                    <form id="import-wizard-form" @onsubmit="NextAsync" @onsubmit:preventDefault="true">
                        <MudStack Spacing="2" Class="wizard-connection">
                            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                                La connexion est enregistrée chiffrée sur le serveur de l'API et n'est jamais renvoyée.
                                Si l'API tourne dans Docker, <code>localhost</code> désigne le conteneur : saisissez <code>host.docker.internal</code>.
                            </MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="8">
                                    <MudTextField T="string" @bind-Value="_form.Server" Label="Serveur" Placeholder="@ServerPlaceholder" Immediate="true"
                                                  Class="field-server" Required="true" AutoFocus="true" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int?" @bind-Value="_form.Port" Label="@($"Port ({ServerEngines.DefaultPort(_form.Engine)} par défaut)")"
                                                     Min="1" Max="65535" Class="field-port" HideSpinButtons="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" @bind-Value="_form.Database" Label="Base de données" Immediate="true" Class="field-database" Required="true" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <NativeSelect Label="Authentification" Value="@_form.AuthMode" ValueChanged="@(v => _form.AuthMode = v)" Class="field-auth">
                                        <option value="Sql">Identifiant et mot de passe</option>
                                        @if (ServerEngines.SupportsIntegrated(_form.Engine))
                                        {
                                            <option value="Integrated">Compte Windows de l'API</option>
                                        }
                                    </NativeSelect>
                                </MudItem>
                                @if (_form.AuthMode == "Sql")
                                {
                                    <MudItem xs="12" sm="4">
                                        <MudTextField T="string" @bind-Value="_form.User" Label="Identifiant" Immediate="true" Class="field-user" autocomplete="off" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField T="string" @bind-Value="_form.Password" Label="Mot de passe" InputType="InputType.Password" Immediate="true"
                                                      Class="field-password" autocomplete="new-password" />
                                    </MudItem>
                                }
                            </MudGrid>
                            <MudCheckBox T="bool" @bind-Value="_form.Encrypt" Label="Chiffrer la connexion (recommandé)" Class="field-encrypt" />
                            <MudCheckBox T="bool" @bind-Value="_form.TrustServerCertificate" Label="Faire confiance au certificat du serveur (déconseillé en production)" Class="field-trust" />
                            @if (!_form.Encrypt)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="unencrypted-warning">
                                    Sans chiffrement, l'identifiant et le mot de passe circulent en clair sur le réseau.
                                </MudAlert>
                            }
                        </MudStack>
                    </form>
                    break;

                case Step.Content:
                    <MudStack Spacing="2" Class="wizard-content">
                        <MudAlert Severity="Severity.Success" Dense="true" Class="connection-test">@_test!.Message</MudAlert>
                        @if (_test.Schemas.Count > 0 && ServerEngines.SupportsSchemas(_form.Engine))
                        {
                            <fieldset class="wizard-schemas" id="schemas">
                                <legend class="native-select-label">Schémas à documenter</legend>
                                @foreach (var schema in _test.Schemas)
                                {
                                    var current = schema;
                                    <div>
                                        <MudCheckBox T="bool" Value="@_selected.Contains(current.Name)" ValueChanged="@(on => ToggleSchema(current.Name, on))"
                                                     Label="@($"{current.Name} ({current.Tables})")" Dense="true" Size="Size.Small" />
                                    </div>
                                }
                            </fieldset>
                            @if (_selected.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="wizard-schema-hint">Cochez au moins un schéma à documenter.</MudText>
                            }
                        }
                        @if (!IsEdit)
                        {
                            <MudTextField T="string" @bind-Value="_form.Name" Label="Nom affiché (facultatif)" Immediate="true" Class="field-name" />
                            <MudTextField T="string" @bind-Value="_form.Description" Label="Description (facultatif)" Immediate="true" Class="field-description" />
                        }
                    </MudStack>
                    break;

                default:
                    <MudStack Spacing="2" Class="wizard-summary">
                        <MudText Class="wizard-summary-text">@Summary</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                            @(IsEdit ? "La base sera relue tout de suite avec cette connexion ; les descriptions déjà saisies sont conservées."
                                     : "Tables, colonnes, clés et index seront lus et documentables immédiatement. Aucune donnée n'est copiée.")
                        </MudText>
                    </MudStack>
                    break;
            }

            @if (_error != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3 connection-error">@_error</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy" Class="wizard-cancel">Annuler</MudButton>
        @if (_step > 0)
        {
            <MudButton OnClick="Back" Disabled="_busy" Class="wizard-back">Précédent</MudButton>
        }
        @if (_steps[_step].Key == Step.Summary)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy" Class="wizard-finish save-connection"
                       StartIcon="@Icons.Material.Filled.Download">@(IsEdit ? "Enregistrer la connexion" : "Importer")</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextAsync" Disabled="@(_busy || !CanContinue)" Class="wizard-next">
                @(_steps[_step].Key == Step.Connection ? "Tester et continuer" : "Suivant")
            </MudButton>
        }
        @if (_busy)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    </DialogActions>
</MudDialog>

@code {
    private enum Step { Source, Connection, Content, Summary }

    private sealed record StepInfo(Step Key, string Title);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Base dont on remplace la connexion ; null pour un import.</summary>
    [Parameter] public DatabaseView? Existing { get; set; }

    private readonly ServerConnectionInput _form = new();
    private readonly HashSet<string> _selected = [];
    private List<StepInfo> _steps = [];
    private ConnectionTestResult? _test;
    private int _step;
    private bool _busy;
    private string? _error;

    private bool IsEdit => Existing != null;

    protected override void OnInitialized()
    {
        // Pour une base existante, le moteur est figé : on saute le choix du type.
        _steps = IsEdit
            ? [new(Step.Connection, "Connexion"), new(Step.Content, "Schémas"), new(Step.Summary, "Récapitulatif")]
            : [new(Step.Source, "Type de base"), new(Step.Connection, "Connexion"), new(Step.Content, "Contenu"), new(Step.Summary, "Récapitulatif")];
        if (Existing == null) return;
        _form.Name = Existing.Name;
        if (!string.IsNullOrEmpty(Existing.Type)) _form.Engine = Existing.Type;
    }

    private string StepClass(int index) => index == _step ? "wizard-step current" : index < _step ? "wizard-step done" : "wizard-step";

    private string ServerPlaceholder => _form.Engine switch
    {
        ServerEngines.PostgreSql => "pg.exemple.fr",
        ServerEngines.MySql => "mysql.exemple.fr",
        _ => "srv-sql.exemple.fr ou localhost\\SQLEXPRESS"
    };

    private MarkupString RightHint => new(_form.Engine switch
    {
        ServerEngines.PostgreSql => "Un compte qui peut se connecter à la base et a <code>USAGE</code> sur les schémas suffit.",
        ServerEngines.MySql => "Un compte qui peut lire la base (<code>SELECT</code>) suffit ; seules les métadonnées sont consultées.",
        _ => "Un compte qui a seulement l'autorisation <code>VIEW DEFINITION</code> suffit."
    });

    private bool ConnectionReady => !string.IsNullOrWhiteSpace(_form.Server) && !string.IsNullOrWhiteSpace(_form.Database)
                                    && (_form.AuthMode != "Sql" || (!string.IsNullOrWhiteSpace(_form.User) && !string.IsNullOrEmpty(_form.Password)));

    private bool SchemasChosen => _test is not { Schemas.Count: > 0 } || !ServerEngines.SupportsSchemas(_form.Engine) || _selected.Count > 0;

    /// <summary>Le bouton « Suivant » reste grisé tant que l'étape est incomplète (jamais d'erreur seulement après l'envoi).</summary>
    private bool CanContinue => _steps[_step].Key switch
    {
        Step.Connection => ConnectionReady,
        Step.Content => SchemasChosen,
        _ => true
    };

    private string Summary
    {
        get
        {
            var chosen = ChosenSchemas();
            var scope = chosen == null ? "tous les schémas" : chosen.Count == 1 ? $"le schéma {chosen[0]}" : $"{chosen.Count} schémas";
            var name = string.IsNullOrWhiteSpace(_form.Name) ? _form.Database : _form.Name;
            return IsEdit
                ? $"La connexion de « {Existing!.Name} » pointera vers {_form.Database} sur {_form.Server} ({ServerEngines.DisplayName(_form.Engine)}), {scope}."
                : $"« {name} » : base {ServerEngines.DisplayName(_form.Engine)} {_form.Database} sur {_form.Server}, {scope}.";
        }
    }

    private void SetEngine(string engine)
    {
        _form.Engine = engine;
        if (!ServerEngines.SupportsIntegrated(engine)) _form.AuthMode = "Sql";
        _test = null;
        _error = null;
    }

    private List<string>? ChosenSchemas()
    {
        if (_test is not { Ok: true } || _test.Schemas.Count == 0 || !ServerEngines.SupportsSchemas(_form.Engine)) return null;
        return _selected.Count == _test.Schemas.Count ? null : _selected.ToList();
    }

    private void ToggleSchema(string name, bool on)
    {
        if (on) _selected.Add(name);
        else _selected.Remove(name);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Back()
    {
        _error = null;
        if (_step > 0) _step--;
    }

    private async Task NextAsync()
    {
        if (_busy || !CanContinue) return;
        _error = null;
        // Tester la connexion avant de laisser passer : on ne choisit pas des schémas d'une connexion qui ne marche pas.
        if (_steps[_step].Key == Step.Connection && !await TestAsync()) return;
        if (_step < _steps.Count - 1) _step++;
    }

    private async Task<bool> TestAsync()
    {
        _busy = true;
        try
        {
            var result = await Api.TestServerAsync(_form);
            if (!result.Ok)
            {
                _test = null;
                _error = result.Message;
                return false;
            }

            _test = result;
            _selected.Clear();
            foreach (var schema in result.Schemas) _selected.Add(schema.Name);
            return true;
        }
        catch (ApiException ex)
        {
            _test = null;
            _error = ex.Message;
            return false;
        }
        catch (HttpRequestException)
        {
            _test = null;
            _error = "L'API est injoignable.";
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            _form.Schemas = ChosenSchemas();
            var result = Existing == null ? await Api.ImportServerAsync(_form) : await Api.UpdateServerConnectionAsync(Existing.Id, _form);
            Workspace.NotifyCatalogChanged(Existing?.Id, this);
            Notifier.Show(Existing == null
                ? $"Base {result.Database.Name} importée : {result.Sync.TablesAdded} table(s), {result.Sync.ColumnsAdded} colonne(s)."
                : $"Connexion enregistrée et base resynchronisée : {result.Sync.TablesAdded} table(s) ajoutée(s), {result.Sync.TablesRemoved} supprimée(s).");
            _form.Password = null; // le mot de passe ne reste pas dans la page
            MudDialog.Close(DialogResult.Ok(result.Database.Id));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "L'API est injoignable.";
        }
        finally
        {
            _busy = false;
        }
    }
}
