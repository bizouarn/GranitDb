@using System.Globalization
@using GranitDb.Client.Diagram
@using Wpflow.Blazor
@using Wpflow.Core
@using FlowNode = Wpflow.Core.Node
@using FlowEdge = Wpflow.Core.Edge
@inject IJSRuntime JS

@* Affichage interactif d'un diagramme, au-dessus de Wpflow.Blazor : les tables sont des nœuds (glisser, zoom, déplacement de la vue,
   minimap), les relations des liens dont le tracé vient d'ErDiagram. La sélection reste celle de la page (Wpflow ne sélectionne rien). *@
<div class="er-canvas" @ref="_host">
    <FlowView @ref="_flow" Class="er-flow" Nodes="_nodes" NodesChanged="n => _nodes = n" Edges="_edges"
              Viewport="_viewport" ViewportChanged="ViewportChangedAsync" MinZoom="MinZoom" MaxZoom="MaxZoom" FitViewOnInit="false"
              NodeTemplate="_nodeTemplate" EdgeTypes="_edgeTypes" EdgeTemplates="_edgeTemplates" EdgeHitWidth="0"
              NodeExtent="Bounds" NodeDragThreshold="4" AutoPanOnNodeDrag="false" OnlyRenderVisibleElements="@(_nodes.Count > VirtualizeAbove)"
              ElementsSelectable="false" NodesConnectable="false" EdgesReconnectable="false" DeleteKeyEnabled="false" HistoryEnabled="false"
              NodesFocusable="false" EdgesFocusable="false" AnnounceSelection="false" ZoomOnDoubleClick="false" ShowBackground="true"
              OnNodesChange="NodesChanging" OnNodeClick="NodeClickAsync" OnNodeDoubleClick="NodeDoubleClickAsync"
              OnNodeDragStart="DragStarted" OnNodeDrag="DraggingAsync" OnNodeDragStop="DragStoppedAsync"
              OnPaneClick="_ => OnClearSelection.InvokeAsync()" OnInit="FitIfPendingAsync">
        <FlowMiniMap NodeColor="MiniMapColor" Width="170" Height="120" Zoomable="true" />
        <FlowControls ShowZoom="false" ShowInteractive="false" />
    </FlowView>
</div>

@code {
    private const double MinZoom = 0.1;
    private const double MaxZoom = 2.5;
    private const string EdgeType = "er";

    /// <summary>Au-delà, seules les tables proches de la vue sont dessinées.</summary>
    private const int VirtualizeAbove = 200;

    private static readonly Wpflow.Core.Rect Bounds = new(0, 0, 10_000_000, 10_000_000);

    /// <summary>Ce qu'un nœud affiche : tout est dans le nœud, car Wpflow ne redessine un nœud que s'il change.</summary>
    private sealed record TableView(ErNode Table, string State, IReadOnlyList<string> RowStates);

    /// <summary>De même pour un lien : la relation qu'il trace et sa mise en évidence.</summary>
    private sealed record RelationView(ErEdge Relation, bool Active);

    private FlowView? _flow;
    private ElementReference _host;
    private IReadOnlyList<FlowNode> _nodes = [];
    private IReadOnlyList<FlowEdge> _edges = [];
    private readonly Dictionary<string, IEdgePathProvider> _edgeTypes;
    private readonly Dictionary<string, RenderFragment<EdgeRenderContext>> _edgeTemplates;
    private readonly RenderFragment<FlowNode> _nodeTemplate;

    private Viewport _viewport = Viewport.Identity;
    private int? _viewKey;
    private bool _fitPending;
    private string? _signature;
    private ErDiagram? _built;

    private (string Id, double X, double Y)? _dragStart;
    private bool _outside;

    public ErDiagramView()
    {
        _nodeTemplate = node => RenderTable((TableView)node.Data!);
        // Le tracé dépend des colonnes reliées : il vient du modèle plutôt que des poignées.
        _edgeTypes = new Dictionary<string, IEdgePathProvider>
        {
            [EdgeType] = new DelegateEdgePathProvider(geometry =>
                new Wpflow.Core.EdgePath(Diagram.Route(((RelationView)geometry.Edge!.Data!).Relation)?.Path ?? "", 0, 0, 0, 0))
        };
        _edgeTemplates = new Dictionary<string, RenderFragment<EdgeRenderContext>>
        {
            [EdgeType] = context => RenderEdge((RelationView)context.Edge.Data!, context.Path.Path)
        };
    }

    [Parameter, EditorRequired] public ErDiagram Diagram { get; set; } = null!;

    /// <summary>Échelle d'affichage (1 = taille réelle).</summary>
    [Parameter] public double Zoom { get; set; } = 1;

    /// <summary>La molette ou le cadrage ont changé l'échelle.</summary>
    [Parameter] public EventCallback<double> ZoomChanged { get; set; }

    /// <summary>Change quand un autre dessin est ouvert : la vue revient à l'origine et cadre le tout.</summary>
    [Parameter] public int ViewKey { get; set; }

    [Parameter] public string? SelectedTableId { get; set; }

    [Parameter] public string? SelectedColumnId { get; set; }

    /// <summary>Identifiants (tables et colonnes) qui dépendent de la sélection.</summary>
    [Parameter] public IReadOnlySet<string> Dependents { get; set; } = new HashSet<string>();

    /// <summary>Identifiants (tables et colonnes) dont dépend la sélection.</summary>
    [Parameter] public IReadOnlySet<string> Dependencies { get; set; } = new HashSet<string>();

    /// <summary>Une table vient d'être déplacée (relâchée dans le dessin) : la place peut être mémorisée.</summary>
    [Parameter] public EventCallback<ErNode> OnNodeMoved { get; set; }

    /// <summary>
    ///     Le pointeur sort du dessin avec une table accrochée (ex : vers un domaine à côté) : le parent peut en faire
    ///     la cible d'un dépôt.
    /// </summary>
    [Parameter] public EventCallback<ErNode> OnDragLeave { get; set; }

    /// <summary>La table, sortie du dessin, y est revenue : plus de dépôt en vue.</summary>
    [Parameter] public EventCallback OnDragBack { get; set; }

    /// <summary>
    ///     La table est relâchée hors du dessin, sur le domaine donné (null : ailleurs). Elle reprend sa place dans le dessin.
    /// </summary>
    [Parameter] public EventCallback<(ErNode Node, string? DomainId)> OnDroppedOutside { get; set; }

    /// <summary>Clic dans le vide du dessin (hors de toute table) : la sélection peut être levée.</summary>
    [Parameter] public EventCallback OnClearSelection { get; set; }

    [Parameter] public EventCallback<string> OnSelectTable { get; set; }

    /// <summary>Double-clic sur une table (ou une de ses colonnes) : ouvrir sa fiche.</summary>
    [Parameter] public EventCallback<(string TableId, string? ColumnId)> OnOpenTable { get; set; }

    [Parameter] public EventCallback<(string TableId, string ColumnId)> OnSelectColumn { get; set; }

    protected override void OnParametersSet()
    {
        if (_viewKey != ViewKey)
        {
            _viewKey = ViewKey;
            _viewport = new Viewport(0, 0, Zoom);
            _fitPending = true;
        }
        else if (Math.Abs(_viewport.Zoom - Zoom) > 0.0001)
        {
            // Boutons de zoom de la page : le centre du dessin visible reste en place.
            var (width, height) = _flow?.Size ?? (0, 0);
            _viewport = ViewportMath.ZoomAt(_viewport, new XYPosition(width / 2, height / 2), Zoom, MinZoom, MaxZoom);
        }

        var signature = Signature();
        if (!ReferenceEquals(_built, Diagram) || signature != _signature)
        {
            _built = Diagram;
            _signature = signature;
            Build();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await FitIfPendingAsync();

    /// <summary>Cadre le dessin dès que sa place à l'écran est connue (sans jamais l'agrandir au-delà de sa taille réelle).</summary>
    private async Task FitIfPendingAsync()
    {
        if (!_fitPending || _flow == null || _flow.Size.Width <= 0 || _nodes.Count == 0) return;
        _fitPending = false;
        await _flow.FitView(new FitViewOptions(0.05, MinZoom, 1));
    }

    private async Task ViewportChangedAsync(Viewport viewport)
    {
        var zoomed = Math.Abs(viewport.Zoom - _viewport.Zoom) > 0.0001;
        _viewport = viewport;
        if (zoomed && Math.Abs(viewport.Zoom - Zoom) > 0.0001) await ZoomChanged.InvokeAsync(viewport.Zoom);
    }

    /// <summary>Ce qui, hors changement de diagramme, demande de redessiner : la sélection et les places (réorganisation en place).</summary>
    private string Signature()
    {
        var text = new System.Text.StringBuilder();
        text.Append(SelectedTableId).Append('|').Append(SelectedColumnId).Append('|')
            .AppendJoin(',', Dependents).Append('|').AppendJoin(',', Dependencies).Append('|');
        foreach (var node in Diagram.Nodes) text.Append(CultureInfo.InvariantCulture, $"{node.X};{node.Y};");
        return text.ToString();
    }

    private void Build()
    {
        var siblings = SelectedColumnId == null ? new HashSet<string>() : Diagram.SiblingColumns(SelectedColumnId);
        _nodes = Diagram.Nodes.Select(node => new FlowNode(node.Id, new XYPosition(node.X, node.Y), "table",
            new TableView(node, StateOf(node.Id) + (node.IsFrontier ? " er-frontier" : ""),
                node.Rows.Select(r => StateOf(r.ColumnId, SelectedColumnId) + (siblings.Contains(r.ColumnId) ? " er-sibling" : "")).ToList()),
            node.Width, node.Height, FixedWidth: node.Width, FixedHeight: node.Height)).ToList();

        var touched = Dependents.Union(Dependencies).ToHashSet();
        _edges = Diagram.Edges.Select(edge => new FlowEdge(edge.RelationId, edge.ReferencingTableId, edge.ReferencedTableId,
            Type: EdgeType, Data: new RelationView(edge, IsActive(edge, touched)),
            Selectable: false, Deletable: false, Reconnectable: false)).ToList();
    }

    private static string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private RenderFragment RenderTable(TableView view)
    {
        var node = view.Table;
        return @<div class="@($"er-node{view.State}")" data-table="@node.Name" style="@($"height:{N(node.Height)}px")">
            <div class="@($"er-head{(node.TableType == "Table" ? "" : " er-head-view")}")"
                 style="@($"height:{N(node.HeaderHeight)}px{(node.Color == null ? "" : $";background:{node.Color};color:{node.Ink}")}")">
                <div class="er-title" style="@($"height:{N(ErDiagram.HeaderHeight)}px")">@node.Name</div>
                @if (node.Caption != null)
                {
                    <div class="er-caption" style="@($"height:{N(ErDiagram.CaptionHeight)}px")">@node.Caption</div>
                }
            </div>
            @for (var i = 0; i < node.Rows.Count; i++)
            {
                var row = node.Rows[i];
                <div class="@($"er-row{view.RowStates[i]}")" data-column="@row.Name" data-column-id="@row.ColumnId"
                     style="@($"height:{N(ErDiagram.RowHeight)}px")">
                    <span class="er-key">@(row.IsPrimaryKey ? "PK" : row.IsForeignKey ? "FK" : "")</span>
                    <span class="@(row.IsPrimaryKey ? "er-col er-col-pk" : "er-col")">@row.Name</span>
                    <span class="er-type">@row.DataType</span>
                </div>
            }
        </div>;
    }

    private RenderFragment RenderEdge(RelationView view, string path)
    {
        var (edge, active) = view;
        var route = Diagram.Route(edge);
        if (route == null) return _ => { };
        var (many, one) = ErDiagram.Cardinality(edge.RelationType);
        var toRight = route.X2 > route.X1;
        var down = route.Y2 > route.Y1;
        return @<g>
            <path d="@path" class="@($"er-edge{(active ? " er-edge-active" : "")}")" />
            @if (route.Vertical)
            {
                @Txt("er-card", route.X1 + 5, route.Y1 + (down ? 12 : -5), many)
                @Txt("er-card", route.X2 + 5, route.Y2 + (down ? -5 : 12), one)
            }
            else
            {
                @Txt("er-card", route.X1 + (toRight ? 6 : -6), route.Y1 - 5, many, toRight ? "start" : "end")
                @Txt("er-card", route.X2 + (toRight ? -6 : 6), route.Y2 - 5, one, toRight ? "end" : "start")
            }
        </g>;
    }

    /// <summary>Texte SVG (Razor réserve la balise <c>text</c> : l'élément est construit à la main).</summary>
    private static RenderFragment Txt(string cssClass, double x, double y, string content, string? anchor = null)
    {
        return builder =>
        {
            builder.OpenElement(0, "text");
            builder.AddAttribute(1, "class", cssClass);
            builder.AddAttribute(2, "x", N(x));
            builder.AddAttribute(3, "y", N(y));
            if (anchor != null) builder.AddAttribute(4, "text-anchor", anchor);
            builder.AddContent(5, content);
            builder.CloseElement();
        };
    }

    private string StateOf(string id, string? selected)
    {
        if (id == selected) return " er-selected";
        if (Dependents.Contains(id)) return " er-dependent";
        return Dependencies.Contains(id) ? " er-dependency" : "";
    }

    private string StateOf(string tableId) => StateOf(tableId, SelectedTableId);

    private bool IsActive(ErEdge edge, HashSet<string> touched)
    {
        bool Hit(string tableId, string columnId) =>
            tableId == SelectedTableId || touched.Contains(tableId) || touched.Contains(columnId);
        return (SelectedTableId != null || touched.Count > 0)
               && Hit(edge.ReferencingTableId, edge.ReferencingColumnId)
               && Hit(edge.ReferencedTableId, edge.ReferencedColumnId);
    }

    private static string? MiniMapColor(FlowNode node)
    {
        var table = ((TableView)node.Data!).Table;
        return table.IsFrontier ? null : table.Color ?? "var(--mud-palette-primary)";
    }

    /// <summary>Avant que Wpflow n'applique un déplacement : le modèle suit, les liens sont tracés à la nouvelle place.</summary>
    private void NodesChanging(IReadOnlyList<NodeChange> changes)
    {
        foreach (var change in changes.OfType<NodePositionChange>())
            if (Diagram.Node(change.Id) is { } node)
                (node.X, node.Y) = (change.Position.X, change.Position.Y);
    }

    /// <summary>La colonne visée par un geste sur un nœud (null : l'en-tête de la table).</summary>
    private static string? ColumnOf(NodeEventArgs e) => e.TargetData.GetValueOrDefault("column-id");

    private Task NodeClickAsync(NodeEventArgs e) => ColumnOf(e) is { } column
        ? OnSelectColumn.InvokeAsync((e.Node.Id, column))
        : OnSelectTable.InvokeAsync(e.Node.Id);

    private Task NodeDoubleClickAsync(NodeEventArgs e) => OnOpenTable.InvokeAsync((e.Node.Id, ColumnOf(e)));

    private void DragStarted(NodeDragEventArgs e)
    {
        _outside = false;
        // Le modèle n'a pas encore bougé : c'est la place à rendre si la table est déposée hors du dessin.
        _dragStart = Diagram.Node(e.Node.Id) is { } node ? (node.Id, node.X, node.Y) : null;
    }

    private bool IsOutside(XYPosition screen)
    {
        var (width, height) = _flow?.Size ?? (0, 0);
        return width > 0 && (screen.X < 0 || screen.Y < 0 || screen.X > width || screen.Y > height);
    }

    private async Task DraggingAsync(NodeDragEventArgs e)
    {
        var outside = IsOutside(e.Pointer.Screen);
        if (outside == _outside || Diagram.Node(e.Node.Id) is not { } node) return;
        _outside = outside;
        if (outside) await OnDragLeave.InvokeAsync(node);
        else await OnDragBack.InvokeAsync();
    }

    private async Task DragStoppedAsync(NodeDragEventArgs e)
    {
        var start = _dragStart;
        _dragStart = null;
        _outside = false;
        if (Diagram.Node(e.Node.Id) is not { } node) return;
        if (!IsOutside(e.Pointer.Screen))
        {
            _signature = Signature(); // Wpflow a déjà la nouvelle place : rien à reconstruire.
            await OnNodeMoved.InvokeAsync(node);
            return;
        }

        string? domainId = null;
        try
        {
            domainId = await JS.InvokeAsync<string?>("granitdb.domainAt", _host, e.Pointer.Screen.X, e.Pointer.Screen.Y);
        }
        catch (JSException)
        {
            // Sans réponse du navigateur, le dépôt est abandonné.
        }

        if (start is { } place && place.Id == node.Id)
        {
            (node.X, node.Y) = (place.X, place.Y);
            _signature = Signature();
            Build();
        }

        await OnDroppedOutside.InvokeAsync((node, domainId));
    }
}
