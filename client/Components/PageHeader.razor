@* Le titre d'une page et, en dessous, son explication (le contenu, facultatif). *@
<MudText Typo="Typo.h4" Class="@(ChildContent == null ? "mb-4" : "mb-1")">@Title</MudText>
@if (ChildContent != null)
{
    <Muted Class="mb-4">@ChildContent</Muted>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
