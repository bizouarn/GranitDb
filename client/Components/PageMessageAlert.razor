@* Affiche le message de la page (rien tant qu'il n'y en a pas) ; la croix le ferme. *@
@if (Message.Text != null)
{
    <MudAlert Severity="Message.Severity" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="Message.Clear">@Message.Text</MudAlert>
}

@code {
    [Parameter, EditorRequired] public PageMessage Message { get; set; } = null!;
}
