# Copiez ce fichier en .env pour utiliser SQL Server comme catalogue :
#   docker compose --profile sqlserver up --build
CATALOG_PROVIDER=SqlServer
MSSQL_SA_PASSWORD=Granit_Dev_Passw0rd
CATALOG_CONNECTION_STRING=Server=sqlserver;Database=GranitDb;User Id=sa;Password=Granit_Dev_Passw0rd;TrustServerCertificate=True

# Authentification GitHub (facultative) : AUTH_ENABLED=true, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, AUTH_FIRST_ADMIN=<votre login GitHub>
