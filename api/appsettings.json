{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Catalog": {
    "Provider": "Sqlite",
    "DataDirectory": "granitdb-data",
    "MaxUploadMb": 100,
    "AllowLocalPaths": false,
    "AllowSqlServerSources": true
  }
}
